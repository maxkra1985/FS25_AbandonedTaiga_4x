<?xml version="1.0" encoding="iso-8859-1"?>

<i3D name="fontRUSMaterialHolder" version="1.6" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://i3d.giants.ch/schema/i3d-1.6.xsd">

  <Files>
    <File fileId="4" filename="$data/shaders/alphabetShader.xml"/>
    <File fileId="5" filename="fontRUS_alpha.dds"/>
    <File fileId="2" filename="fontRUS_normal.png"/>
    <File fileId="3" filename="$data/shared/alphabet/font_specular.png"/>
  </Files>


  <Materials>
    <Material name="fontRUS_mat" materialId="6" diffuseColor="0.5 0.5 0.5 1" customShaderId="4">
      <Normalmap fileId="2"/>
      <Glossmap fileId="3"/>
      <Custommap name="alphaMap" fileId="5"/>
    </Material>
    <Material name="fontRUSNoNormal_mat" materialId="7" diffuseColor="0.5 0.5 0.5 1" customShaderId="4">
      <Glossmap fileId="3"/>
      <Custommap name="alphaMap" fileId="5"/>
    </Material>
  </Materials>


  <Shapes externalShapesFile="fontRUSMaterialHolder.i3d.shapes">
  </Shapes>

  <Scene>
      <TransformGroup name="fonts" nodeId="12">
        <TransformGroup name="licensePlateRUS" nodeId="13">
          <Shape name="licensePlateRUS" shapeId="1" castsShadows="true" receiveShadows="true" materialIds="6" clipDistance="300" nodeId="14"/>
          <Shape name="licensePlateRUS_noNormal" translation="0 2 0" shapeId="2" castsShadows="true" receiveShadows="true" materialIds="7" clipDistance="300" nodeId="15"/>
        </TransformGroup>
      </TransformGroup>
      <TransformGroup name="characters" nodeId="16">
        <Shape name="character" translation="-2 0 0" shapeId="3" castsShadows="true" receiveShadows="true" materialIds="6" clipDistance="15" nodeId="17"/>
      </TransformGroup>
  </Scene>

  <UserAttributes>
  </UserAttributes>

</i3D>
