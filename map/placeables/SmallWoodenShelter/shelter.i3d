    <Material name="wood_mat" materialId="9" customShaderId="4" customShaderVariation="customParallax">
      <Texture fileId="1"/>
      <Normalmap fileId="2" bumpDepth="2.2"/>
      <Glossmap fileId="3"/>
      <Custommap name="mMaskMap" fileId="5"/>
      <Custommap name="mParallaxMap" fileId="10"/>
    </Material>
  </Materials>


  <Shapes externalShapesFile="shelter.i3d.shapes">
  </Shapes>

  <Scene>
    <TransformGroup name="woodenShelter" lockedgroup="true" clipDistance="600" nodeId="18">
      <TransformGroup name="clearAreas" nodeId="19">
        <TransformGroup name="clearAreaStart01" translation="-5.136 0 -5.40677" nodeId="20">
          <TransformGroup name="clearAreaWidth01" translation="6.404 0 0" nodeId="21"/>
          <TransformGroup name="clearAreaHeight01" translation="0 0 10.617" nodeId="22"/>
        </TransformGroup>
      </TransformGroup>
      <TransformGroup name="levelAreas" nodeId="23">
        <TransformGroup name="levelAreaStart01" translation="-5.13557 0 -5.40677" nodeId="24">
          <TransformGroup name="levelAreaWidth01" translation="6.404 0 0" nodeId="25"/>
          <TransformGroup name="levelAreaHeight01" translation="0 0 10.617" nodeId="26"/>
        </TransformGroup>
      </TransformGroup>
      <TransformGroup name="indoorAreas" nodeId="27">
        <TransformGroup name="indoorAreaStart01" translation="-5.136 0 -5.40677" nodeId="28">
          <TransformGroup name="indoorAreaWidth01" translation="6.404 0 0" nodeId="29"/>
          <TransformGroup name="indoorAreaHeight01" translation="0 0 11.1309" nodeId="30"/>
