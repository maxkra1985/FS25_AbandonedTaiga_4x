  <Materials>
    <Material name="collision_mat" materialId="5" diffuseColor="0.8 0 0 1" specularColor="0.501961 1 0">
    </Material>
    <Material name="dach_mat" materialId="6" customShaderId="4" customShaderVariation="customParallax">
      <Texture fileId="11"/>
      <Normalmap fileId="12" bumpDepth="0.3"/>
      <Glossmap fileId="13"/>
      <Custommap name="mMaskMap" fileId="5"/>
      <Custommap name="mParallaxMap" fileId="14"/>
    </Material>
    <Material name="snow_mat" materialId="7" customShaderId="17">
