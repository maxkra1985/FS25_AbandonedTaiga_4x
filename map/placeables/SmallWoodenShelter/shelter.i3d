        <TransformGroup name="visuals_lod" lodDistance="0 100" lodBlending="false" nodeId="38">
          <Shape name="LOD0" shapeId="1" nodeId="39" castsShadows="true" receiveShadows="true" materialIds="9">
            <Shape name="dach" shapeId="2" nodeId="40" castsShadows="true" receiveShadows="true" materialIds="6"/>
          </Shape>
          <Shape name="LOD1" shapeId="3" nodeId="41" castsShadows="true" receiveShadows="true" materialIds="9">
