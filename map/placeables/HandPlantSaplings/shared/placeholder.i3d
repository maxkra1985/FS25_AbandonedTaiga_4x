<?xml version="1.0" encoding="iso-8859-1"?>

<i3D name="placeholder" version="1.6" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://i3d.giants.ch/schema/i3d-1.6.xsd">

  <Files>
    <File fileId="3" filename="$data/placeables/brandless/greenhouses/shared/dirt_diffuse.dds"/>
    <File fileId="4" filename="$data/placeables/brandless/greenhouses/shared/dirt_normal.dds"/>
    <File fileId="5" filename="$data/placeables/brandless/greenhouses/shared/dirt_specular.dds"/>
    <File fileId="2" filename="$data/shaders/glowShader.xml"/>
    <File fileId="6" filename="$data/shaders/placeableShader.xml"/>
    <File fileId="1" filename="placeholder_diffuse.dds"/>
  </Files>


  <Materials>
    <Material name="dirt_mat" materialId="5" customShaderId="6" customShaderVariation="customParallax">
      <Texture fileId="3"/>
      <Normalmap fileId="4"/>
      <Glossmap fileId="5"/>
    </Material>
    <Material name="placeholderGlow_mat" materialId="6" alphaBlending="true" customShaderId="2" customShaderVariation="additive_colorScale">
      <Emissivemap fileId="1"/>
      <CustomParameter name="colorScale" value="0 1 0"/>
    </Material>
  </Materials>


  <Shapes externalShapesFile="placeholder.i3d.shapes">
  </Shapes>

  <Scene>
    <Shape name="placeholder" shapeId="1" clipDistance="50" nodeId="10" castsShadows="true" receiveShadows="true" materialIds="6">
      <Shape name="dirt" scale="1.5 2 1.5" shapeId="2" clipDistance="80" nodeId="11" castsShadows="true" receiveShadows="true" decalLayer="1" materialIds="5"/>
    </Shape>
  </Scene>

</i3D>
