<?xml version="1.0" encoding="iso-8859-1"?>

<i3D name="dummyShovel" version="1.6" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://i3d.giants.ch/schema/i3d-1.6.xsd">

  <Files>
    <File fileId="2" filename="$data/shaders/ghostShader.xml"/>
    <File fileId="1" filename="$data/shared/window_diffuse.png"/>
  </Files>

  <Materials>
    <Material name="dummyShove_mat" materialId="63" specularColor="0.5 0.5 0.5" alphaBlending="true" customShaderId="2">
      <CustomParameter name="ghostColorScaleEnd" value="0.3 0.3 0.3 0.1"/>
      <CustomParameter name="ghostColorScaleStart" value="0.1 0.1 0.1 0.1"/>
	  <Emissivemap fileId="1"/>
    </Material>
  </Materials>


  <Shapes externalShapesFile="dummyShovel.i3d.shapes">
  </Shapes>

  <Scene>
    <Shape name="dummyShovel" shapeId="1" castsShadows="true" receiveShadows="true" materialIds="63" clipDistance="500" nodeId="1"/>
  </Scene>

</i3D>
