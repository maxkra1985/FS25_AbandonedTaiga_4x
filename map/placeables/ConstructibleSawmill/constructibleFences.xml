<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<placeable type="constructible" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../../../../shared/xml/schema/placeable.xsd">
	<storeData>
		<name>Ограждение старой лесопилки</name>
		<functions>
			<function>Для реконструкции ограждения требуются инструменты и доски</function>
		</functions>
		<image>map/placeables/ConstructibleBuildings.dds</image>
		<price>0</price>
		<canBeSold>true</canBeSold>
		<showInStore>false</showInStore>
		<lifetime>100000</lifetime>
		<dailyUpkeep>0</dailyUpkeep>
		<rotation>0</rotation>
		<brand>ConstructibleBuildings</brand>
		<species>placeable</species>
		<category>farmhouses</category>
		<brush>
			<type>placeable</type>
			<category>ConstructibleBuildings</category>
			<tab>constructiblesProductionPoint</tab>
		</brush>
		<vertexBufferMemoryUsage>719616</vertexBufferMemoryUsage>
		<indexBufferMemoryUsage>141312</indexBufferMemoryUsage>
		<textureMemoryUsage>1507328</textureMemoryUsage>
		<instanceVertexBufferMemoryUsage>0</instanceVertexBufferMemoryUsage>
		<instanceIndexBufferMemoryUsage>0</instanceIndexBufferMemoryUsage>

		<storeIconRendering>
			<objectBundle>
				<object filename="map/placeables/ConstructibleSawmill/constructibleFences.i3d">
					<node node="2"/>
				</object>
			</objectBundle>
		</storeIconRendering>
		<audioMemoryUsage>0</audioMemoryUsage>
	</storeData>

	<base>
		<filename>map/placeables/ConstructibleSawmill/constructibleFences.i3d</filename>
		<canBeRenamed>true</canBeRenamed>
		<canBeDeleted>true</canBeDeleted>
		<boughtWithFarmland>true</boughtWithFarmland>
	</base>

	<placement useRandomYRotation="false" useManualYRotation="true">
		<testAreas>
			<testArea startNode="testAreaStart01" endNode="testAreaEnd01" />
		</testAreas>
		<sounds>
			<place template="smallImp" />
		</sounds>
	</placement>

	<clearAreas>
		<clearArea startNode="clearAreaStart01" widthNode="clearAreaWidth01" heightNode="clearAreaHeight01"/>
	</clearAreas>

	<leveling requireLeveling="true" maxSmoothDistance="10" maxSlope="75" maxEdgeAngle="30" >
		<levelAreas>
			<levelArea startNode="levelAreaStart01" widthNode="levelAreaWidth01" heightNode="levelAreaHeight01" />
		</levelAreas>
	</leveling>

	<indoorAreas>
		<indoorArea startNode="indoorAreaStart01" widthNode="indoorAreaWidth01" heightNode="indoorAreaHeight01" />
	</indoorAreas>

	<tipOcclusionUpdateAreas>
		<tipOcclusionUpdateArea startNode="tipOcclusionUpdateAreaStart01" endNode="tipOcclusionUpdateAreaEnd01" />
	</tipOcclusionUpdateAreas>

	<ai>
		<updateAreas>
			<updateArea startNode="tipOcclusionUpdateAreaStart01" endNode="tipOcclusionUpdateAreaEnd01" />
		</updateAreas>
	</ai>

	<infoTrigger triggerNode="infoTrigger"/>

	<hotspots>
		<hotspot type="UNLOADING_PALLET" linkNode="unloadTriggerMarker" teleportNode="unloadTriggerMarker" />
	</hotspots>

	<triggerMarkers>
		<triggerMarker node="unloadTriggerMarker" filename="markerIcons/markerIconStroyka.i3d" adjustToGround="true" />
		<triggerMarker node="warningStripes01"/>
	</triggerMarkers>

	<animatedObjects>
		<animatedObject saveId="door04" useAIBlockingRegion="true">
			<animation duration="1.5">
				<part node="gate6mOpenA">
					<keyFrame time="0.1" rotation="0 0 0"/>
					<keyFrame time="1.2" rotation="0 90 0"/>
				</part>
				<part node="gate6mOpenB">
					<keyFrame time="0.1" rotation="0 0 0"/>
					<keyFrame time="1.2" rotation="0 -90 0"/>
				</part>
			</animation>
			<controls triggerNode="gate6mTrigger" posAction="ACTIVATE_HANDTOOL" posText="action_openDoor" negText="action_closeDoor" />
			<sounds>
				<moving linkNode="gate6m" template="fenceLoop" />
				<posEnd linkNode="gate6m" template="fenceOpen" />
				<negEnd linkNode="gate6m" template="fenceClose" />
			</sounds>
		</animatedObject>
	</animatedObjects>

	<constructible>
		<stateMachine>
			<states>
				<state name="SETUP" StateName="Разбор въезда" class="ConstructibleStateBuilding" >
					<toggleMesh node="build_01"		active="false" updatePhysics="true"/>
					<toggleMesh node="build_02"		active="false" updatePhysics="true"/>
					<toggleMesh node="build_03"		active="false" updatePhysics="true"/>
					<toggleMesh node="build_04"		active="false" updatePhysics="true"/>
					<toggleMesh node="build_05"		active="false" updatePhysics="true"/>
					<toggleMesh node="build_06"		active="false" updatePhysics="true"/>
					<toggleMesh node="build_07"		active="false" updatePhysics="true"/>
					<toggleMesh node="build_08"		active="false" updatePhysics="true"/>
					<toggleMesh node="build_09"		active="false" updatePhysics="true"/>
					<toggleMesh node="gate6m"		active="false" updatePhysics="true"/>
					<input fillType="INSTRUMENT"	amount="40" usagePerHour="80"/>
					<sounds>
						<active template="carpenterSmallWork"/>
					</sounds>
				</state>

				<state name="BUILDING_1" StateName="Реконструкция левой стороны" class="ConstructibleStateBuilding" >
					<toggleMesh node="destroy_01"	active="false"	updatePhysics="true"/>
					<input fillType="INSTRUMENT"	amount="40"		usagePerHour="20"/>
					<input fillType="BOARDS"		amount="999"	usagePerHour="500"/>
					<sounds>
						<active template="carpenterSmallWork"/>
					</sounds>
				</state>

				<state name="BUILDING_2" StateName="Реконструкция левого угла" class="ConstructibleStateBuilding" >
					<toggleMesh node="destroy_02"	active="false"	updatePhysics="true"/>
					<toggleMesh node="build_01"		active="true"	updatePhysics="true"/>
					<input fillType="INSTRUMENT"	amount="40"		usagePerHour="20"/>
					<input fillType="BOARDS"		amount="999"	usagePerHour="500"/>
					<sounds>
						<active template="carpenterSmallWork"/>
					</sounds>
				</state>

				<state name="BUILDING_3" StateName="Реконструкция дальней стороны" class="ConstructibleStateBuilding" >
					<toggleMesh node="destroy_03"	active="false"	updatePhysics="true"/>
					<toggleMesh node="build_02"		active="true"	updatePhysics="true"/>
					<input fillType="INSTRUMENT"	amount="40"		usagePerHour="20"/>
					<input fillType="BOARDS"		amount="999"	usagePerHour="500"/>
					<sounds>
						<active template="carpenterSmallWork"/>
					</sounds>
				</state>

				<state name="BUILDING_4" StateName="Реконструкция дальнего угла" class="ConstructibleStateBuilding" >
					<toggleMesh node="destroy_04"	active="false"	updatePhysics="true"/>
					<toggleMesh node="build_03"		active="true"	updatePhysics="true"/>
					<input fillType="INSTRUMENT"	amount="40"		usagePerHour="20"/>
					<input fillType="BOARDS"		amount="999"	usagePerHour="500"/>
					<sounds>
						<active template="carpenterSmallWork"/>
					</sounds>
				</state>

				<state name="BUILDING_5" StateName="Реконструкция правой стороны" class="ConstructibleStateBuilding" >
					<toggleMesh node="destroy_05"	active="false"	updatePhysics="true"/>
					<toggleMesh node="build_04"		active="true"	updatePhysics="true"/>
					<input fillType="INSTRUMENT"	amount="40"		usagePerHour="20"/>
					<input fillType="BOARDS"		amount="999"	usagePerHour="500"/>
					<sounds>
						<active template="carpenterSmallWork"/>
					</sounds>
				</state>

				<state name="BUILDING_6" StateName="Реконструкция правого угла" class="ConstructibleStateBuilding" >
					<toggleMesh node="destroy_06"	active="false"	updatePhysics="true"/>
					<toggleMesh node="build_05"		active="true"	updatePhysics="true"/>
					<input fillType="INSTRUMENT"	amount="40"		usagePerHour="20"/>
					<input fillType="BOARDS"		amount="999"	usagePerHour="500"/>
					<sounds>
						<active template="carpenterSmallWork"/>
					</sounds>
				</state>

				<state name="BUILDING_7" StateName="Реконструкция прямого участка" class="ConstructibleStateBuilding" >
					<toggleMesh node="destroy_07"	active="false"	updatePhysics="true"/>
					<toggleMesh node="build_06"		active="true"	updatePhysics="true"/>
					<input fillType="INSTRUMENT"	amount="40"		usagePerHour="20"/>
					<input fillType="BOARDS"		amount="999"	usagePerHour="500"/>
					<sounds>
						<active template="carpenterSmallWork"/>
					</sounds>
				</state>

				<state name="BUILDING_8" class="ConstructibleStateBuilding" >
					<toggleMesh node="destroy_08"	active="false"	updatePhysics="true"/>
					<toggleMesh node="build_07"		active="true"	updatePhysics="true"/>
					<input fillType="INSTRUMENT"	amount="40"		usagePerHour="20"/>
					<input fillType="BOARDS"		amount="999"	usagePerHour="500"/>
					<sounds>
						<active template="carpenterSmallWork"/>
					</sounds>
				</state>

				<state name="BUILDING_9" StateName="Завершение реконструкции забора" class="ConstructibleStateBuilding" >
					<toggleMesh node="destroy_09"	active="false"	updatePhysics="true"/>
					<toggleMesh node="build_08"		active="true"	updatePhysics="true"/>
					<input fillType="INSTRUMENT"	amount="40"		usagePerHour="20"/>
					<input fillType="BOARDS"		amount="999"	usagePerHour="500"/>
					<sounds>
						<active template="carpenterSmallWork"/>
					</sounds>
				</state>

				<state name="BUILDING_10" StateName="Установка въездных ворот" class="ConstructibleStateBuilding" >
					<toggleMesh node="oldFence"		active="false"	updatePhysics="true"/>
					<toggleMesh node="build_09"		active="true"	updatePhysics="true"/>
					<input fillType="INSTRUMENT"	amount="40"		usagePerHour="20"/>
					<input fillType="BOARDS"		amount="999"	usagePerHour="500"/>
					<sounds>
						<active template="carpenterSmallWork"/>
					</sounds>
				</state>

				<state name="FINALIZE" class="ConstructibleStateFinalize" >
					<toggleMesh node="gate6m"		active="true"	updatePhysics="true"/>
					<toggleMesh node="ConstructibleSellingStation"	active="false" updatePhysics="true"/>
					<toggleHotspot index="1" isVisible="false"/>
				</state>

				<state name="DONE" class="ConstructibleState" isPreviewState="true"/>
			</states>

			<transitions>
				<transition from="SETUP"		to="BUILDING_1" />
				<transition from="BUILDING_1"	to="BUILDING_2" />
				<transition from="BUILDING_2"	to="BUILDING_3" />
				<transition from="BUILDING_3"	to="BUILDING_4" />
				<transition from="BUILDING_4"	to="BUILDING_5" />
				<transition from="BUILDING_5"	to="BUILDING_6" />
				<transition from="BUILDING_6"	to="BUILDING_7" />
				<transition from="BUILDING_7"	to="BUILDING_8" />
				<transition from="BUILDING_8"	to="BUILDING_9" />
				<transition from="BUILDING_9"	to="BUILDING_10" />
				<transition from="BUILDING_10"	to="FINALIZE" />
				<transition from="FINALIZE"		to="DONE" />
			</transitions>
		</stateMachine>

		<sellingStation appearsOnStats="true" supportsExtension="false">
			<palletTrigger triggerNode="palletTrigger" aiNode="unloadTriggerAINode" fillTypes="INSTRUMENT BOARDS" />
		</sellingStation>

		<storage isExtension="false" fillLevelSyncThreshold="50">
			<capacity fillType="INSTRUMENT"		capacity="500" />
			<capacity fillType="BOARDS"			capacity="5000" />
		</storage>
	</constructible>

	<i3dMappings>
		<i3dMapping id="clearAreaStart01" node="0>0|0|0" />
		<i3dMapping id="clearAreaWidth01" node="0>0|0|0|0" />
		<i3dMapping id="clearAreaHeight01" node="0>0|0|0|1" />
		<i3dMapping id="levelAreaStart01" node="0>0|1|0" />
		<i3dMapping id="levelAreaWidth01" node="0>0|1|0|0" />
		<i3dMapping id="levelAreaHeight01" node="0>0|1|0|1" />
		<i3dMapping id="indoorAreaStart01" node="0>0|2|0" />
		<i3dMapping id="indoorAreaWidth01" node="0>0|2|0|0" />
		<i3dMapping id="indoorAreaHeight01" node="0>0|2|0|1" />
		<i3dMapping id="testAreaStart01" node="0>0|3|0" />
		<i3dMapping id="testAreaEnd01" node="0>0|3|0|0" />
		<i3dMapping id="tipOcclusionUpdateAreaStart01" node="0>0|4|0" />
		<i3dMapping id="tipOcclusionUpdateAreaEnd01" node="0>0|4|0|0" />

		<i3dMapping id="ConstructibleSellingStation" node="0>3" />
		<i3dMapping id="infoTrigger" node="0>3|0" />
		<i3dMapping id="warningStripes01" node="0>3|1" />
		<i3dMapping id="palletTrigger" node="0>3|2" />
		<i3dMapping id="unloadTriggerMarker" node="0>3|3" />
		<i3dMapping id="unloadTriggerAINode" node="0>3|4" />

		<i3dMapping id="build_01" node="0>2|0" />
		<i3dMapping id="build_02" node="0>2|1" />
		<i3dMapping id="build_03" node="0>2|2" />
		<i3dMapping id="build_04" node="0>2|3" />
		<i3dMapping id="build_05" node="0>2|4" />
		<i3dMapping id="build_06" node="0>2|5" />
		<i3dMapping id="build_07" node="0>2|6" />
		<i3dMapping id="build_08" node="0>2|7" />
		<i3dMapping id="build_09" node="0>2|8" />
		<i3dMapping id="gate6m" node="0>2|9" />
        <i3dMapping id="gate6mOpenA" node="0>2|9|0" />
        <i3dMapping id="gate6mOpenB" node="0>2|9|1" />
        <i3dMapping id="gate6mTrigger" node="0>2|9|4" />
        <i3dMapping id="gate6mSound" node="0>2|9|5" />

		<i3dMapping id="oldFence" node="0>1" />
		<i3dMapping id="destroy_01" node="0>1|0" />
		<i3dMapping id="destroy_02" node="0>1|1" />
		<i3dMapping id="destroy_03" node="0>1|2" />
		<i3dMapping id="destroy_04" node="0>1|3" />
		<i3dMapping id="destroy_05" node="0>1|4" />
		<i3dMapping id="destroy_06" node="0>1|5" />
		<i3dMapping id="destroy_07" node="0>1|6" />
		<i3dMapping id="destroy_08" node="0>1|7" />
		<i3dMapping id="destroy_09" node="0>1|8" />

	</i3dMappings>
</placeable>
