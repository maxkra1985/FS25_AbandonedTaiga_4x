    <Files>
        <File fileId="7" filename="cucumberDead_diffuse.dds"/>
        <File fileId="1" filename="cucumberPlant_diffuse.dds"/>
        <File fileId="6" filename="cucumber_alpha.dds"/>
        <File fileId="2" filename="cucumber_normal.dds"/>
        <File fileId="3" filename="cucumber_specular.dds"/>
        <File fileId="4" filename="$data/shaders/fruitGrowthFoliageShader.xml"/>
    </Files>
    <Materials>
        <Material name="cucumber_mat" materialId="5" customShaderId="4">
            <Texture fileId="1"/>
            <Normalmap fileId="2"/>
            <Glossmap fileId="3"/>
            <Custommap name="alphaMap" fileId="6"/>
            <CustomParameter name="windScale" value="0 0 0 0"/>
            <CustomParameter name="snowScale" value="0 0 0 0"/>
        </Material>
        <Material name="cucumberDead_mat" materialId="6" customShaderId="4">
            <Texture fileId="7"/>
            <Normalmap fileId="2"/>
            <Glossmap fileId="3"/>
            <Custommap name="alphaMap" fileId="6"/>
            <CustomParameter name="windScale" value="0 0 0 0"/>
            <CustomParameter name="snowScale" value="0 0 0 0"/>
        </Material>
    </Materials>
    <Shapes externalShapesFile="cucumber.i3d.shapes"/>
    <Dynamics/>
    <Scene>
        <TransformGroup name="lod0" nodeId="11">
            <Shape shapeId="1" name="cucumberMature" clipDistance="100" nodeId="13" materialIds="5" castsShadows="true" receiveShadows="true"/>
            <Shape shapeId="2" name="cucumberSmall" clipDistance="100" nodeId="12" materialIds="5" castsShadows="true" receiveShadows="true"/>
            <Shape shapeId="3" name="cucumberDead" clipDistance="100" nodeId="14" materialIds="6" castsShadows="true" receiveShadows="true"/>
        </TransformGroup>
    </Scene>
</i3D>
