<?xml version="1.0" encoding="iso-8859-1"?>

<i3D name="strawberry.i3d" version="1.6" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://i3d.giants.ch/schema/i3d-1.6.xsd">
  <Asset>
    <Export program="GIANTS Editor 64bit" version="10.0.6"/>
  </Asset>

  <Files>
    <File fileId="4" filename="$data/shaders/fruitGrowthFoliageShader.xml"/>
    <File fileId="6" filename="strawberryStage01_alpha.png"/>
    <File fileId="1" filename="strawberryStage01_diffuse.png"/>
    <File fileId="3" filename="strawberryStage01_fmask.png"/>
    <File fileId="2" filename="strawberryStage01_normal.png"/>
    <File fileId="10" filename="strawberryStage02_alpha.png"/>
    <File fileId="7" filename="strawberryStage02_diffuse.png"/>
    <File fileId="9" filename="strawberryStage02_fmask.png"/>
    <File fileId="8" filename="strawberryStage02_normal.png"/>
    <File fileId="14" filename="strawberryStage03_alpha.png"/>
    <File fileId="11" filename="strawberryStage03_diffuse.png"/>
    <File fileId="13" filename="strawberryStage03_fmask.png"/>
    <File fileId="12" filename="strawberryStage03_normal.png"/>
  </Files>


  <Materials>
    <Material name="strawberryStage01_mat" materialId="7" customShaderId="4">
      <Texture fileId="1"/>
      <Normalmap fileId="2"/>
      <Glossmap fileId="3"/>
      <Custommap name="alphaMap" fileId="6"/>
      <CustomParameter name="windScale" value="0"/>
      <CustomParameter name="snowScale" value="0"/>
    </Material>
    <Material name="strawberryStage02_mat" materialId="6" customShaderId="4">
      <Texture fileId="7"/>
      <Normalmap fileId="8"/>
      <Glossmap fileId="9"/>
      <Custommap name="alphaMap" fileId="10"/>
      <CustomParameter name="windScale" value="0"/>
      <CustomParameter name="snowScale" value="0"/>
    </Material>
    <Material name="strawberryStage03_mat" materialId="5" customShaderId="4">
      <Texture fileId="11"/>
      <Normalmap fileId="12"/>
      <Glossmap fileId="13"/>
      <Custommap name="alphaMap" fileId="14"/>
      <CustomParameter name="windScale" value="0"/>
      <CustomParameter name="snowScale" value="0"/>
    </Material>
  </Materials>


  <Shapes externalShapesFile="strawberry.i3d.shapes">
  </Shapes>

  <Scene>
    <TransformGroup name="strawberry" nodeId="12">
      <Shape name="greenSmall" shapeId="1" clipDistance="150" nodeId="13" castsShadows="true" receiveShadows="true" materialIds="7"/>
      <Shape name="greenBig" shapeId="2" clipDistance="150" nodeId="14" castsShadows="true" receiveShadows="true" materialIds="6"/>
      <Shape name="dead" shapeId="3" clipDistance="150" nodeId="15" castsShadows="true" receiveShadows="true" materialIds="5"/>
    </TransformGroup>
  </Scene>

</i3D>
