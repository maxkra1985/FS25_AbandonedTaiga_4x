<?xml version="1.0" encoding="utf-8" standalone="no"?>
<vehicle type="pallet" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://validation.gdn.giants-software.com/xml/fs25/vehicle.xsd">
	<annotation>Copyright (C) GIANTS Software GmbH, All Rights Reserved.</annotation>

	<storeData>
		<name>cabbagePallet</name>
		<image>$data/store/store_empty.png</image>
		<category>pallets</category>
		<brand>LIZARD</brand>
		<showInStore>false</showInStore>
		<canBeSold>false</canBeSold>
		<financeCategory>OTHER</financeCategory>
		<vertexBufferMemoryUsage>76032</vertexBufferMemoryUsage>
		<indexBufferMemoryUsage>12288</indexBufferMemoryUsage>
		<textureMemoryUsage>1703936</textureMemoryUsage>
		<audioMemoryUsage>0</audioMemoryUsage>
		<instanceVertexBufferMemoryUsage>0</instanceVertexBufferMemoryUsage>
		<instanceIndexBufferMemoryUsage>0</instanceIndexBufferMemoryUsage>
	</storeData>

	<base>
		<typeDesc>$l10n_typeDesc_pallet</typeDesc>
		<filename>map/placeables/GardenBeds/pallets/cabbageBox/cabbagePallet.i3d</filename>
		<size width="1.4" length="1" height="1"/>
		<canBeReset>false</canBeReset>
		<components>
			<component centerOfMass="0 0.1 0" solverIterationCount="10" mass="60"/>
		</components>
		<showInVehicleMenu>false</showInVehicleMenu>
		<mapHotspot available="false"/>
	</base>

	<fillUnit>
		<fillUnitConfigurations>
			<fillUnitConfiguration>
				<fillUnits removeVehicleIfEmpty="true">
					<fillUnit unitTextOverride="$l10n_unit_literShort" fillTypes="WHITECABBAGE" capacity="300" ignoreFillLimit="true"/>
				</fillUnits>
			</fillUnitConfiguration>
		</fillUnitConfigurations>
	</fillUnit>

	<dischargeable requiresTipOcclusionArea="false">
		<dischargeNode node="0|1" emptySpeed="40" fillUnitIndex="1" maxDistance="4" canStartDischargeAutomatically="true" playSound="false"/>
	</dischargeable>

	 <pallet fillUnitIndex="1" node="0">
		<content>
			<object node="0|2|0" tensionBeltNode="0|2|0|0"/>
			<object node="0|2|1" tensionBeltNode="0|2|1|0"/>
			<object node="0|2|2" tensionBeltNode="0|2|2|0"/>
			<object node="0|2|3" tensionBeltNode="0|2|3|0"/>
			<object node="0|2|4" tensionBeltNode="0|2|4|0"/>
			<object node="0|2|5" tensionBeltNode="0|2|5|0"/>
			<object node="0|2|6" tensionBeltNode="0|2|6|0"/>
			<object node="0|2|7" tensionBeltNode="0|2|7|0"/>
		</content>


		<sounds>
			<unload template="palletsFillPlastic" pitchScale="0.8"/>
		</sounds>
	</pallet>

	<dynamicMount triggerNode="0|0" triggerForceAcceleration="5" additionalMountDistance="0.8" jointTransY="0.11" jointLimitToRotY="true"/>
</vehicle>
