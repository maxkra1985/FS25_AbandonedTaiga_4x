            <object node="cucumbersBox9" tensionBeltNode="cucumbersBox9Tension"/>
            <object node="cucumbersBox10" tensionBeltNode="cucumbersBox10Tension"/>
            <object node="cucumbersBox11" tensionBeltNode="cucumbersBox11Tension"/>
            <object node="cucumbersBox12" tensionBeltNode="cucumbersBox12Tension"/>
            <object node="cucumbersBox13" tensionBeltNode="cucumbersBox13Tension"/>
