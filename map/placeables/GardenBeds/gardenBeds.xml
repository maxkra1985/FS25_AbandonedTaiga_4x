<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<placeable type="greenhouseSeasonal" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../../../../shared/xml/schema/placeable.xsd">
	<storeData>
		<name>Грядки</name>
		<functions>
			<function>$l10n_function_productionPoint</function>
		</functions>
		<image>map/placeables/GardenBeds/gardenBeds.dds</image>
		<price>5</price>
		<dailyUpkeep>0</dailyUpkeep>
		<lifetime>1000</lifetime>
		<rotation>0</rotation>
		<brand>NONE</brand>
		<species>PLACEABLE</species>
		<category>placeableMisc</category>
		<brush>
			<type>placeable</type>
			<category>production</category>
			<tab>greenhouses</tab>
		</brush>
		<canBeSold>true</canBeSold>
		<showInStore>true</showInStore>
		<vertexBufferMemoryUsage>888576</vertexBufferMemoryUsage>
		<indexBufferMemoryUsage>176640</indexBufferMemoryUsage>
		<textureMemoryUsage>1179648</textureMemoryUsage>
		<instanceVertexBufferMemoryUsage>0</instanceVertexBufferMemoryUsage>
		<instanceIndexBufferMemoryUsage>0</instanceIndexBufferMemoryUsage>
		<audioMemoryUsage>0</audioMemoryUsage>
	</storeData>

	<base>
		<filename>map/placeables/GardenBeds/gardenBeds.i3d</filename>
		<canBeRenamed>true</canBeRenamed>
		<canBeDeleted>true</canBeDeleted>
		<boughtWithFarmland>true</boughtWithFarmland>
	</base>

	<placement useRandomYRotation="false" useManualYRotation="true" >
		<testAreas>
			<testArea startNode="testAreaStart01" endNode="testAreaEnd01" />
		</testAreas>
		<sounds>
			<place template="largeImp" />
		</sounds>
	</placement>

	<clearAreas>
		<clearArea startNode="clearAreaStart01" widthNode="clearAreaWidth01" heightNode="clearAreaHeight01"/>
	</clearAreas>

	<leveling requireLeveling="true" maxSmoothDistance="1" maxSlope="75" maxEdgeAngle="30">
		<levelAreas>
			<levelArea startNode="levelAreaStart01" widthNode="levelAreaWidth01" heightNode="levelAreaHeight01" groundType="grassCut01"/>
		</levelAreas>
	</leveling>

	<indoorAreas>
		<indoorArea startNode="indoorArea01Start" widthNode="indoorAreaWidth01" heightNode="indoorArea1Height"/>
	</indoorAreas>

	<tipOcclusionUpdateAreas>
		<tipOcclusionUpdateArea startNode="tipOcclusionUpdateAreaStart01" endNode="tipOcclusionUpdateAreaEnd01" />
	</tipOcclusionUpdateAreas>

	<ai>
		<updateAreas>
			<updateArea startNode="tipOcclusionUpdateAreaStart01" endNode="tipOcclusionUpdateAreaEnd01" />
		</updateAreas>
	</ai>

	<infoTrigger triggerNode="infoTrigger" />

	<hotspots>
		<hotspot type="PRODUCTION_POINT" linkNode="playerTriggerMarker" teleportNode="teleportNode" />
	</hotspots>

	<triggerMarkers>
		<triggerMarker node="warningStripes_palletSpawnArea"	adjustToGround="true" />
		<triggerMarker node="warningStripes_unloads"	adjustToGround="true" />
		<triggerMarker node="playerTriggerMarker"		adjustToGround="true"	filename="$data/shared/assets/marker/markerIconWrench.i3d" />
		<triggerMarker node="bulkUnloadTriggerMarker"	adjustToGround="true"	filename="$data/shared/assets/marker/markerIconUnload.i3d"/>
		<triggerMarker node="waterUnloadTriggerMarker"	adjustToGround="true"	filename="$data/shared/assets/marker/markerIconWater.i3d" />
	</triggerMarkers>

	<greenhouse>
		<plants>
			<plant fillType="STRAWBERRY"	xmlFilename="map/placeables/GardenBeds/plants/strawberry/strawberry.xml"/>
			<plant fillType="CUCUMBER"		xmlFilename="map/placeables/GardenBeds/plants/cucumber.xml"/>
			<plant fillType="TOMATO"		xmlFilename="map/placeables/GardenBeds/plants/tomatoes.xml"/>
			<plant fillType="WHITECABBAGE"	xmlFilename="map/placeables/GardenBeds/plants/cabbage.xml"/>
		</plants>

		<plantSpaces>
			<spacesParent node="plantNodes" useRandomYRot="true" />
		</plantSpaces>
		<sounds>
			<watering template="defaultSprayer" linkNode="planters_01" loops="0" />
		</sounds>
	</greenhouse>

	<productionPoint>
		<productions>
			<production id="strawberry" name="Клубника" cyclesPerHour="128" costsPerActiveHour="0.1" minTemperature="5" optimalTemperatureMin="22" optimalTemperatureMax="28" maxTemperature="40" temperatureImpact="1.00" fertilizerFillType="FERTILIZER" fertilizerPerCycle="1" fertilizerFactor="1.8" growthHeatRequirement="70">
				<inputs>
					<input fillType="SEEDS" amount="1" allowbuying="true"/>
					<input fillType="WATER" amount="5" allowbuying="false"/>
				</inputs>
				<outputs>
					<output fillType="STRAWBERRY" amount="8"/>
				</outputs>
			</production>
			<production id="cucumber" name="Огурцы" cyclesPerHour="64" costsPerActiveHour="0.1" minTemperature="10" optimalTemperatureMin="20" optimalTemperatureMax="27" maxTemperature="45" temperatureImpact="1.00" fertilizerFillType="FERTILIZER" fertilizerPerCycle="1" fertilizerFactor="1.8" growthHeatRequirement="65">
				<inputs>
					<input fillType="SEEDS" amount="1" allowbuying="true"/>
					<input fillType="WATER" amount="5" allowbuying="false"/>
				</inputs>
				<outputs>
					<output fillType="CUCUMBER" amount="15"/>
				</outputs>
			</production>
			<production id="tomato" name="Помидоры" cyclesPerHour="64" costsPerActiveHour="0.1" minTemperature="10" optimalTemperatureMin="18" optimalTemperatureMax="28" maxTemperature="40" temperatureImpact="0.60" fertilizerFillType="FERTILIZER" fertilizerPerCycle="1" fertilizerFactor="1.8" growthHeatRequirement="60">
				<inputs>
					<input fillType="SEEDS" amount="1" allowbuying="true"/>
					<input fillType="WATER" amount="5" allowbuying="false"/>
				</inputs>
				<outputs>
					<output fillType="TOMATO" amount="10"/>
				</outputs>
			</production>
			<production id="whitecabbage" name="Капуста" cyclesPerHour="32" costsPerActiveHour="0.1" minTemperature="5" optimalTemperatureMin="10" optimalTemperatureMax="20" maxTemperature="50" temperatureImpact="0.35" fertilizerFillType="FERTILIZER" fertilizerPerCycle="1" fertilizerFactor="1.8" growthHeatRequirement="50">
				<inputs>
					<input fillType="SEEDS" amount="1" allowbuying="true"/>
					<input fillType="WATER" amount="5" allowbuying="false"/>
				</inputs>
				<outputs>
					<output fillType="WHITECABBAGE" amount="9"/>
				</outputs>
			</production>
		</productions>

		<sellingStation node="sellingStation" supportsExtension="false" allowMissions="true" appearsOnStats="false" hideFromPricesMenu="true">
			<supportedFillTypes>
				<fillType name="SEEDS" />
				<fillType name="FERTILIZER" />
				<fillType name="WATER" />
			</supportedFillTypes>
			<palletTrigger	triggerNode="palletExactFillRootNode"		aiNode="unloadTriggerAINode"	fillTypes="SEEDS FERTILIZER" />
			<unloadTrigger	exactFillRootNode="bulkExactFillRootNode"	aiNode="unloadTriggerAINode"	fillTypes="SEEDS FERTILIZER" />
			<unloadTrigger	exactFillRootNode="waterExactFillRootNode"	aiNode="unloadTriggerAINode"	fillTypes="WATER" />
		</sellingStation>

		<!--loadingStation fillTypes="WATER" supportsExtension="true" /-->

		<palletSpawner>
			<spawnPlaces>
				<spawnPlace startNode="spawnPlaceStart01" endNode="spawnPlaceEnd01" />
				<spawnPlace startNode="spawnPlaceStart02" endNode="spawnPlaceEnd02" />
			</spawnPlaces>
		</palletSpawner>

		<storage node="palletSpawner" isExtension="false" fillLevelSyncThreshold="10" >
			<capacity fillType="WATER"			capacity="40000" />
			<capacity fillType="FERTILIZER"		capacity="10000" />
			<capacity fillType="SEEDS"			capacity="10000" />
			<capacity fillType="STRAWBERRY"		capacity="28000" />
			<capacity fillType="CUCUMBER"		capacity="28000" />
			<capacity fillType="TOMATO"			capacity="28000" />
			<capacity fillType="WHITECABBAGE"	capacity="28000" />
		</storage>

		<playerTrigger node="playerTrigger" />
	</productionPoint>

	<i3dMappings>
		<!-- AREAS -->
		<i3dMapping id="testAreaStart01" node="0>0|0|0" />
		<i3dMapping id="testAreaEnd01" node="0>0|0|0|0" />
		<i3dMapping id="clearAreaStart01" node="0>0|1|0" />
		<i3dMapping id="clearAreaHeight01" node="0>0|1|0|0" />
		<i3dMapping id="clearAreaWidth01" node="0>0|1|0|1" />
		<i3dMapping id="levelAreaStart01" node="0>0|2|0" />
		<i3dMapping id="levelAreaWidth01" node="0>0|2|0|0" />
		<i3dMapping id="levelAreaHeight01" node="0>0|2|0|1" />
		<i3dMapping id="indoorArea01Start" node="0>0|3|0" />
		<i3dMapping id="indoorAreaWidth01" node="0>0|3|0|0" />
		<i3dMapping id="indoorArea1Height" node="0>0|3|0|1" />
		<i3dMapping id="tipOcclusionUpdateAreaStart01" node="0>0|4|0" />
		<i3dMapping id="tipOcclusionUpdateAreaEnd01" node="0>0|4|0|0" />

		<!-- ТРИГГЕРЫ -->
		<i3dMapping id="infoTrigger" node="0>1|0" />
		<i3dMapping id="playerTrigger" node="0>1|1" />
		<i3dMapping id="playerTriggerMarker" node="0>1|1|0" />
		<i3dMapping id="teleportNode" node="0>1|1|1" />
		<i3dMapping id="warningStripes_palletSpawnArea" node="0>1|2|0" />
		<i3dMapping id="warningStripes_unloads" node="0>1|2|1" />
		<i3dMapping id="bulkUnloadTriggerMarker" node="0>1|3" />
		<i3dMapping id="waterUnloadTriggerMarker" node="0>1|4" />
		<i3dMapping id="unloadTriggerAINode" node="0>1|5" />
		<i3dMapping id="palletExactFillRootNode" node="0>2|1|0" />
		<i3dMapping id="bulkExactFillRootNode" node="0>2|1|1" />
		<i3dMapping id="waterExactFillRootNode" node="0>2|1|2" />

		<!-- ГРЯДКИ -->
		<i3dMapping id="plantNodes" node="0>2|0" />
		<i3dMapping id="sellingStation" node="0>2|1" />
		<i3dMapping id="palletSpawner" node="0>2|2" />
		<i3dMapping id="spawnPlaceStart01" node="0>2|2|0" />
		<i3dMapping id="spawnPlaceEnd01" node="0>2|2|0|0" />
		<i3dMapping id="spawnPlaceStart02" node="0>2|2|1" />
		<i3dMapping id="spawnPlaceEnd02" node="0>2|2|1|0" />
		<i3dMapping id="planters_01" node="0>3|1|0" />
	</i3dMappings>
</placeable>
