<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<placeable type="productionPointWithStorage" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../../../../shared/xml/schema/placeable.xsd">
	<storeData>
		<name>Консервация овощей и ягод</name>
		<image>map/placeables/ConstructibleBuildings.dds</image>
		<functions>
			<function>Домик на хуторе с местом для консервации овощей и ягод.</function>
			<function>Также есть склад для хранения поддонов.</function>
		</functions>
		<price>50000</price>
		<canBeSold>true</canBeSold>
		<showInStore>false</showInStore>
		<dailyUpkeep>0</dailyUpkeep>
		<lifetime>1000</lifetime>
		<rotation>0</rotation>
		<brand>ConstructibleBuildings</brand>
		<species>placeable</species>
		<category>productionPoints</category>
		<brush>
			<type>placeable</type>
			<category>ConstructibleBuildings</category>
			<tab>constructiblesProductionPoint</tab>
		</brush>
		<vertexBufferMemoryUsage>0</vertexBufferMemoryUsage>
		<indexBufferMemoryUsage>0</indexBufferMemoryUsage>
		<textureMemoryUsage>0</textureMemoryUsage>
		<instanceVertexBufferMemoryUsage>0</instanceVertexBufferMemoryUsage>
		<instanceIndexBufferMemoryUsage>0</instanceIndexBufferMemoryUsage>
	</storeData>

	<base>
		<filename>map/placeables/FarmWithBeds/canningShop.i3d</filename>
		<canBeRenamed>true</canBeRenamed>
		<canBeDeleted>true</canBeDeleted>
		<boughtWithFarmland>true</boughtWithFarmland>
	</base>

	<placement useRandomYRotation="false" useManualYRotation="true" >
		<testAreas/>
		<sounds/>
	</placement>

	<clearAreas>
		<clearArea startNode="indoorAreaStart01" widthNode="indoorAreaWidth01" heightNode="indoorAreaHeight01"/>
	</clearAreas>

	<leveling requireLeveling="true" maxSmoothDistance="10" maxSlope="75" maxEdgeAngle="30">
		<levelAreas>
			<levelArea startNode="indoorAreaWidth01" widthNode="indoorAreaWidth01" heightNode="indoorAreaHeight01" groundType="concrete"/>
		</levelAreas>
		<paintAreas>
		</paintAreas>
	</leveling>

	<indoorAreas>
		<indoorArea startNode="indoorAreaStart01" widthNode="indoorAreaWidth01" heightNode="indoorAreaHeight01"/>
	</indoorAreas>

	<tipOcclusionUpdateAreas>
		<tipOcclusionUpdateArea startNode="tipOcclusionUpdateAreaStart01" endNode="tipOcclusionUpdateAreaEnd01" />
	</tipOcclusionUpdateAreas>

	<ai>
		<updateAreas>
			<updateArea startNode="tipOcclusionUpdateAreaStart01" endNode="tipOcclusionUpdateAreaEnd01" />
		</updateAreas>
	</ai>

	<infoTrigger triggerNode="infoTrigger"/>

	<triggerMarkers>
		<triggerMarker node="warningStripesProductionPoint"		adjustToGround="true"/>
		<triggerMarker node="paletteUnloadTriggerMarker"		adjustToGround="true"	filename="$data/shared/assets/marker/markerIconUnload.i3d"/>
		<triggerMarker node="storagePalettTriggerMarker"		adjustToGround="true"	filename="$data/shared/assets/marker/markerIconUnload.i3d"/>
		<triggerMarker node="unloadTriggerMarkerWater"			adjustToGround="true"	filename="$data/shared/assets/marker/markerIconWater.i3d" />
		<triggerMarker node="playerTriggerMarker"				adjustToGround="false"	filename="$data/shared/assets/marker/markerIconWrench.i3d"/>
		<triggerMarker node="storagePlayerTrigger"				adjustToGround="false"	filename="$data/shared/assets/marker/markerIconWrench.i3d"/>
	</triggerMarkers>

	<productionPoint>
		<productions sharedThroughputCapacity="true">
			<production id="barrel_cabbage" name="Квашенная капуста" cyclesPerHour="4" costsPerActiveHour="8">
				<inputs>
					<input fillType="WHITECABBAGE" amount="100"/>
					<input fillType="salt" amount="20"/>
					<input fillType="WATER" amount="50"/>
				</inputs>
				<outputs>
					<output fillType="barrel_cabbage" amount="100"/>
				</outputs>
			</production>
			<production id="barrel_cucumbers" name="Бочковые огурцы" cyclesPerHour="4" costsPerActiveHour="8">
				<inputs>
					<input fillType="CUCUMBER" amount="100"/>
					<input fillType="salt" amount="20"/>
					<input fillType="WATER" amount="50"/>
				</inputs>
				<outputs>
					<output fillType="barrel_cucumbers" amount="100"/>
				</outputs>
			</production>
			<production id="barrel_tomatoes" name="Бочковые помидоры" cyclesPerHour="4" costsPerActiveHour="8">
				<inputs>
					<input fillType="TOMATO" amount="100"/>
					<input fillType="salt" amount="20"/>
					<input fillType="WATER" amount="50"/>
				</inputs>
				<outputs>
					<output fillType="barrel_tomatoes" amount="100"/>
				</outputs>
			</production>
			<production id="jar_strawberryJam" name="клубничное варенье" cyclesPerHour="4" costsPerActiveHour="8">
				<inputs>
					<input fillType="STRAWBERRY" amount="100"/>
					<input fillType="SUGAR" amount="15"/>
				</inputs>
				<outputs>
					<output fillType="strawberryJam" amount="70"/>
				</outputs>
			</production>
		</productions>

		<storage isExtension="false" supportsExtension="true" fillLevelSyncThreshold="1000">
			<capacity fillType="WATER"				capacity="50000"/>
			<capacity fillType="SUGAR"				capacity="8000"/>
			<capacity fillType="salt"				capacity="8000"/>
			<capacity fillType="STRAWBERRY"			capacity="20000"/>
			<capacity fillType="TOMATO"				capacity="20000"/>
			<capacity fillType="CUCUMBER"			capacity="20000"/>
			<capacity fillType="WHITECABBAGE"		capacity="20000"/>
			<capacity fillType="strawberryJam"		capacity="10000"/>
			<capacity fillType="barrel_tomatoes"	capacity="10000"/>
			<capacity fillType="barrel_cucumbers"	capacity="10000"/>
			<capacity fillType="barrel_cabbage"		capacity="10000"/>
		</storage>

		<sellingStation node="sellingStation" appearsOnStats="true" supportsExtension="false" hideFromPricesMenu="true">
			<supportedFillTypes>
				<fillType name="WATER" />
				<fillType name="SUGAR" />
				<fillType name="salt" />
				<fillType name="TOMATO" />
				<fillType name="CUCUMBER" />
				<fillType name="WHITECABBAGE" />
				<fillType name="STRAWBERRY" />
			</supportedFillTypes>
			<unloadTrigger exactFillRootNode="exactFillRootNodeWater" aiNode="unloadTriggerAINodeWater" fillTypes="WATER"/>
			<palletTrigger triggerNode="paletteFillRootNode" aiNode="paletteAiUnloadingNode" fillTypes="SUGAR salt TOMATO CUCUMBER WHITECABBAGE STRAWBERRY"/>
		</sellingStation>

		<palletSpawner>
			<spawnPlaces>
				<spawnPlace startNode="spawnSpaceStart01" endNode="spawnSpaceEnd01" />
				<spawnPlace startNode="spawnSpaceStart02" endNode="spawnSpaceEnd02" />
				<spawnPlace startNode="spawnSpaceStart03" endNode="spawnSpaceEnd03" />
				<spawnPlace startNode="spawnSpaceStart04" endNode="spawnSpaceEnd04" />
				<spawnPlace startNode="spawnSpaceStart05" endNode="spawnSpaceEnd05" />
				<spawnPlace startNode="spawnSpaceStart06" endNode="spawnSpaceEnd06" />
			</spawnPlaces>
		</palletSpawner>

		<playerTrigger node="playerTrigger" />

		<sounds/>
	</productionPoint>
	

    <objectStorage isExtension="true" supportsExtension="false" supportsBales="true" supportsPallets="true" maxLength="8.5" maxWidth="6" maxHeight="3.5" fillTypes="SUGAR salt TOMATO CUCUMBER WHITECABBAGE STRAWBERRY strawberryJam barrel_tomatoes barrel_cucumbers barrel_cabbage" >
        <playerTrigger node="storagePlayerTrigger" />
        <objectTrigger node="objectTrigger" />
        <spawnAreas>
            <spawnArea startNode="spawnAreaStart01" endNode="spawnAreaEnd01"/>
        </spawnAreas>
        <storageAreas>
            <storageArea startNode="storageAreaStart01" endNode="storageAreaEnd01"/>
            <storageArea startNode="storageAreaStart02" endNode="storageAreaEnd02"/>
            <storageArea startNode="storageAreaStart03" endNode="storageAreaEnd03"/>
            <storageArea startNode="storageAreaStart04" endNode="storageAreaEnd04"/>
            <storageArea startNode="storageAreaStart05" endNode="storageAreaEnd05"/>
            <storageArea startNode="storageAreaStart06" endNode="storageAreaEnd06"/>
            <storageArea startNode="storageAreaStart07" endNode="storageAreaEnd07"/>
            <storageArea startNode="storageAreaStart08" endNode="storageAreaEnd08"/>
        </storageAreas>
    </objectStorage>

	<hotspots>
		<hotspot type="PRODUCTION_POINT" linkNode="playerTriggerMarker" teleportNode="playerTriggerMarker" />
	</hotspots>

	<animatedObjects>
		<animatedObject saveId="door01" >
			<animation duration="1">
				<part node="door01">
					<keyFrame time="0.0" rotation="0 0 0"/>
					<keyFrame time="1.0" rotation="0 -110 0"/>
				</part>
			</animation>
			<controls triggerNode="door01Trigger" posAction="ACTIVATE_HANDTOOL" posText="action_openDoor" negText="action_closeDoor" />
			<sounds>
				<moving linkNode="door01" template="woodDoorSqueaksSmall" pitchScale="0.8"/>
				<posEnd linkNode="door01" template="woodDoorOpen" />
				<negEnd linkNode="door01" template="woodDoorCloseRandom" />
			</sounds>
		</animatedObject>
		<animatedObject saveId="door02" >
			<animation duration="1">
				<part node="door02">
					<keyFrame time="0.0" rotation="0 0 0"/>
					<keyFrame time="1.0" rotation="0 -80 0"/>
				</part>
			</animation>
			<controls triggerNode="door02Trigger" posAction="ACTIVATE_HANDTOOL" posText="action_openDoor" negText="action_closeDoor" />
			<sounds>
				<moving linkNode="door02" template="woodDoorSqueaksSmall" pitchScale="0.8"/>
				<posEnd linkNode="door02" template="woodDoorOpen" />
				<negEnd linkNode="door02" template="woodDoorCloseRandom" />
			</sounds>
		</animatedObject>
		<animatedObject saveId="door03" >
			<animation duration="1">
				<part node="door03A">
					<keyFrame time="0.0" rotation="0 0 0"/>
					<keyFrame time="1.0" rotation="0 -120 0"/>
				</part>
				<part node="door03B">
					<keyFrame time="0.0" rotation="0 0 0"/>
					<keyFrame time="1.0" rotation="0 120 0"/>
				</part>
			</animation>
			<controls triggerNode="door03Trigger" posAction="ACTIVATE_HANDTOOL" posText="action_openDoor" negText="action_closeDoor" />
			<sounds>
				<moving linkNode="door03" template="woodDoorSqueaksSmall" pitchScale="0.8"/>
				<posEnd linkNode="door03" template="woodDoorOpen" />
				<negEnd linkNode="door03" template="woodDoorCloseRandom" />
			</sounds>
		</animatedObject>
		<animatedObject saveId="slidingDoor04">
			<animation duration="1">
				<part node="slidingDoor04">
					<keyFrame time="0.0" translation="0 0 0"/>
					<keyFrame time="1.0" translation="0 0 -7"/>
				</part>
			</animation>
			<controls triggerNode="slidingDoor04Trigger" posAction="ACTIVATE_HANDTOOL" posText="action_openGate" negText="action_closeGate" />
			<sounds>
				<moving linkNode="slidingDoor04Sound" template="slidingGateWoodLoop" />
				<posEnd linkNode="slidingDoor04Sound" template="woodDoorOpen" />
				<negEnd linkNode="slidingDoor04Sound" template="woodDoorClose" />
			</sounds>
		</animatedObject>
	</animatedObjects>

	<i3dMappings>
		<!-- AREAS -->
		<i3dMapping id="indoorAreaStart01" node="0>0|0" />
		<i3dMapping id="indoorAreaWidth01" node="0>0|1" />
		<i3dMapping id="indoorAreaHeight01" node="0>0|2" />
		<i3dMapping id="tipOcclusionUpdateAreaStart01" node="0>1|0" />
		<i3dMapping id="tipOcclusionUpdateAreaEnd01" node="0>1|1" />

		<!-- ТРИГГЕРЫ -->
		<i3dMapping id="infoTrigger"						node="0>2" />
		<i3dMapping id="warningStripesProductionPoint"		node="0>4|3|0" />
		<i3dMapping id="paletteUnloadTriggerMarker"			node="0>4|1|1" />
		<i3dMapping id="unloadTriggerMarkerWater"			node="0>4|2|1" />
		<i3dMapping id="playerTriggerMarker"				node="0>4|0|0" />
		<i3dMapping id="storagePalettTriggerMarker"			node="0>5|1|0" />

		<!-- ПРОИЗВОДСТВО -->
		<i3dMapping id="playerTrigger" node="0>4|0" />
		<i3dMapping id="paletteFillRootNode"			node="0>4|1" />
		<i3dMapping id="paletteAiUnloadingNode"			node="0>4|1|0" />
		<i3dMapping id="exactFillRootNodeWater"			node="0>4|2" />
		<i3dMapping id="unloadTriggerAINodeWater"		node="0>4|2|0" />
		<i3dMapping id="spawnSpaceStart01" node="0>4|3|1|0" />
		<i3dMapping id="spawnSpaceEnd01" node="0>4|3|1|0|0" />
		<i3dMapping id="spawnSpaceStart02" node="0>4|3|1|1" />
		<i3dMapping id="spawnSpaceEnd02" node="0>4|3|1|1|0" />
		<i3dMapping id="spawnSpaceStart03" node="0>4|3|1|2" />
		<i3dMapping id="spawnSpaceEnd03" node="0>4|3|1|2|0" />
		<i3dMapping id="spawnSpaceStart04" node="0>4|3|1|3" />
		<i3dMapping id="spawnSpaceEnd04" node="0>4|3|1|3|0" />
		<i3dMapping id="spawnSpaceStart05" node="0>4|3|1|4" />
		<i3dMapping id="spawnSpaceEnd05" node="0>4|3|1|4|0" />
		<i3dMapping id="spawnSpaceStart06" node="0>4|3|1|5" />
		<i3dMapping id="spawnSpaceEnd06" node="0>4|3|1|5|0" />

		<!-- СКЛАД -->
        <i3dMapping id="spawnAreaStart01" node="0>5|0|0" />
        <i3dMapping id="spawnAreaEnd01" node="0>5|0|0|0" />
        <i3dMapping id="storageAreaStart01" node="0>5|0|1" />
        <i3dMapping id="storageAreaEnd01" node="0>5|0|1|0" />
        <i3dMapping id="storageAreaStart02" node="0>5|0|2" />
        <i3dMapping id="storageAreaEnd02" node="0>5|0|2|0" />
        <i3dMapping id="storageAreaStart03" node="0>5|0|3" />
        <i3dMapping id="storageAreaEnd03" node="0>5|0|3|0" />
        <i3dMapping id="storageAreaStart04" node="0>5|0|4" />
        <i3dMapping id="storageAreaEnd04" node="0>5|0|4|0" />
        <i3dMapping id="storageAreaStart05" node="0>5|0|5" />
        <i3dMapping id="storageAreaEnd05" node="0>5|0|5|0" />
        <i3dMapping id="storageAreaStart06" node="0>5|0|6" />
        <i3dMapping id="storageAreaEnd06" node="0>5|0|6|0" />
        <i3dMapping id="storageAreaStart07" node="0>5|0|7" />
        <i3dMapping id="storageAreaEnd07" node="0>5|0|7|0" />
        <i3dMapping id="storageAreaStart08" node="0>5|0|8" />
        <i3dMapping id="storageAreaEnd08" node="0>5|0|8|0" />
        <i3dMapping id="objectTrigger" node="0>5|1" />
        <i3dMapping id="storagePlayerTrigger" node="0>5|2" />
		
		<!-- ДВЕРИ -->
		<i3dMapping id="door01" node="0>3|0|13|0" />
		<i3dMapping id="door01Trigger" node="0>3|0|13|1" />
		<i3dMapping id="door02" node="0>3|0|14|0" />
		<i3dMapping id="door02Trigger" node="0>3|0|14|1" />
		<i3dMapping id="door03" node="0>3|1|5" />
		<i3dMapping id="door03A" node="0>3|1|5|0" />
		<i3dMapping id="door03B" node="0>3|1|5|1" />
		<i3dMapping id="door03Trigger" node="0>3|1|5|2" />
		<i3dMapping id="slidingDoor04" node="0>3|2|3|0" />
		<i3dMapping id="slidingDoor04Trigger" node="0>3|2|3|1" />
		<i3dMapping id="slidingDoor04Sound" node="0>3|2|3|0|2" />

	</i3dMappings>
</placeable>
