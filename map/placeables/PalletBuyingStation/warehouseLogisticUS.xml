			<spawnPlaces>
				<spawnPlace startNode="palletAreaStart01" endNode="palletAreaEnd01" palletRotationOffset="90"/>
				<spawnPlace startNode="palletAreaStart02" endNode="palletAreaEnd02" palletRotationOffset="90"/>
