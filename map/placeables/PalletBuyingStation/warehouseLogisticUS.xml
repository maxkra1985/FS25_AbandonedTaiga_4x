<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<placeable type="warehouse" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../../../shared/xml/schema/placeable.xsd">
	<storeData>
		<name>Склад Семёныча</name>
		<functions>
			<function>Место покупки различных товаров</function>
		</functions>
		<image>$data/store/store_empty.png</image>
		<price>0</price>
		<showInStore>true</showInStore>
		<canBeSold>false</canBeSold>
		<lifetime>100000</lifetime>
		<rotation>0</rotation>
		<brand>NONE</brand>
		<species>PLACEABLE</species>
		<category>placeableMisc</category>
		<brush>
			<type>placeable</type>
			<category>buildings</category>
			<tab>tools</tab>
		</brush>
		<vertexBufferMemoryUsage>0</vertexBufferMemoryUsage>
		<indexBufferMemoryUsage>0</indexBufferMemoryUsage>
		<textureMemoryUsage>0</textureMemoryUsage>
		<instanceVertexBufferMemoryUsage>0</instanceVertexBufferMemoryUsage>
		<instanceIndexBufferMemoryUsage>0</instanceIndexBufferMemoryUsage>
	</storeData>

	<base>
		<filename>map/placeables/PalletBuyingStation/warehouseLogisticUS.i3d</filename>
		<canBeRenamed>false</canBeRenamed>
		<canBeDeleted>false</canBeDeleted>
		<boughtWithFarmland>false</boughtWithFarmland>
	</base>

	<placement useRandomYRotation="false" useManualYRotation="true" />

	<clearAreas></clearAreas>

	<leveling></leveling>

	<indoorAreas>
		<indoorArea startNode="indoorAreaStart01" widthNode="indoorAreaWidth01" heightNode="indoorAreaHeight01"/>
	</indoorAreas>

	<tipOcclusionUpdateAreas>
		<tipOcclusionUpdateArea startNode="tipOcclusionUpdateAreaStart01" endNode="tipOcclusionUpdateAreaEnd01" />
	</tipOcclusionUpdateAreas>

	<ai>
		<updateAreas>
			<updateArea startNode="tipOcclusionUpdateAreaStart01" endNode="tipOcclusionUpdateAreaEnd01" />
		</updateAreas>
	</ai>

	<!--infoTrigger triggerNode="infoTrigger"/-->

	<hotspots>
		<hotspot type="SHOP" linkNode="teleportNode" teleportNode="teleportNode" />
	</hotspots>

	<triggerMarkers>
		<triggerMarker node="warningStripes01"/>
	</triggerMarkers>

	<palletBuyingStation triggerNode="palletBuyingActivationTrigger">
