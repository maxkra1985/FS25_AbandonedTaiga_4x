<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<placeable type="hiddenWoodenWell" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../../../../shared/xml/schema/placeable.xsd">
	<storeData>
		<name>Старый колодец</name>
		<image>map/placeables/WoodenWell/store_Woodenfountain.dds</image>
		<functions>
			<function>Даёт доступ к подземным водам</function>
		</functions>
		<price>250</price>
		<dailyUpkeep>0</dailyUpkeep>
		<canBeSold>true</canBeSold>
		<showInStore>true</showInStore>
		<lifetime>1000</lifetime>
		<rotation>0</rotation>
		<brand>ConstructibleBuildings</brand>
		<species>PLACEABLE</species>
		<category>productionPoints</category>
		<brush>
			<type>placeable</type>
			<category>ConstructibleBuildings</category>
			<tab>constructiblesProductionPoint</tab>
		</brush>
		<vertexBufferMemoryUsage>218880</vertexBufferMemoryUsage>
		<indexBufferMemoryUsage>55808</indexBufferMemoryUsage>
		<textureMemoryUsage>4259840</textureMemoryUsage>
		<audioMemoryUsage>0</audioMemoryUsage>
		<instanceVertexBufferMemoryUsage>0</instanceVertexBufferMemoryUsage>
		<instanceIndexBufferMemoryUsage>0</instanceIndexBufferMemoryUsage>
	</storeData>

	<base>
		<filename>map/placeables/WoodenWell/Woodenfountain.i3d</filename>
		<canBeRenamed>true</canBeRenamed>
		<canBeDeleted>true</canBeDeleted>
		<boughtWithFarmland>true</boughtWithFarmland>
	</base>

	<placement useRandomYRotation="false" useManualYRotation="true">
		<testAreas>
			<testArea startNode="testAreaStart01" endNode="testAreaEnd01" />
		</testAreas>

		<sounds>
			<place template="smallImp"/>
		</sounds>
	</placement>

	<clearAreas>
		<clearArea startNode="clearAreaStart01" widthNode="clearAreaWidth01" heightNode="clearAreaHeight01"/>
	</clearAreas>

	<leveling requireLeveling="true" maxSmoothDistance="3" maxSlope="75" maxEdgeAngle="30">
		<levelAreas>
			<levelArea startNode="levelAreaStart01" widthNode="levelAreaWidth01" heightNode="levelAreaHeight01" groundType="asphalt"/>
		</levelAreas>
	</leveling>

	<indoorAreas>
		<indoorArea startNode="indoorAreaStart01" widthNode="indoorAreaWidth01" heightNode="indoorAreaHeight01"/>
	</indoorAreas>

	<tipOcclusionUpdateAreas>
		<tipOcclusionUpdateArea startNode="tipOcclusionUpdateAreaStart01" endNode="tipOcclusionUpdateAreaEnd01" />
	</tipOcclusionUpdateAreas>

	<ai>
		<updateAreas>
			<updateArea startNode="tipOcclusionUpdateAreaStart01" endNode="tipOcclusionUpdateAreaEnd01" />
		</updateAreas>
	</ai>

	<triggerMarkers/>

	<hotspots/>

	<extendedProductionPoint hiddenOnUI="true" sharedThroughputCapacity="false">
		<operatingConditions alwaysActive="true"/>
		<rainWaterCollector collectSnow="true" rainWaterPerMinute="10"/>
		<productions>
			<production id="Water" name="$l10n_fillType_water" cyclesPerHour="4000" costsPerActiveHour="0">
				<inputs>
					<input fillType="GROUNDWATER" amount="0"/>
				</inputs>
				<outputs>
					<output fillType="WATER" amount="1"/>
				</outputs>
			</production>
		</productions>
		<storage isExtension="false" fillLevelSyncThreshold="50">
			<capacity fillType="GROUNDWATER" capacity="100"/>
			<capacity fillType="WATER" capacity="5000"/>
		</storage>
		<sellingStation node="sellingStation" supportsExtension="false" hideFromPricesMenu="true" allowMissions="false">
			<unloadTrigger exactFillRootNode="exactFillRootNode" aiNode="aiUnloadingNode" fillTypes="GROUNDWATER"/>
		</sellingStation>
		<loadingStation>
			<loadTrigger triggerNode="fillTrigger" fillLitersPerSecond="500" fillTypes="WATER" aiNode="aiNode"/>
		</loadingStation>
	</extendedProductionPoint>

	<i3dMappings>
		<i3dMapping id="clearAreaStart01" node="0>0|0" />
		<i3dMapping id="clearAreaWidth01" node="0>0|0|0" />
		<i3dMapping id="clearAreaHeight01" node="0>0|0|1" />
		<i3dMapping id="levelAreaStart01" node="0>1|0" />
		<i3dMapping id="levelAreaWidth01" node="0>1|0|0" />
		<i3dMapping id="levelAreaHeight01" node="0>1|0|1" />
		<i3dMapping id="indoorAreaStart01" node="0>2|0" />
		<i3dMapping id="indoorAreaWidth01" node="0>2|0|0" />
		<i3dMapping id="indoorAreaHeight01" node="0>2|0|1" />
		<i3dMapping id="testAreaStart01" node="0>3|0" />
		<i3dMapping id="testAreaEnd01" node="0>3|0|0" />
		<i3dMapping id="tipOcclusionUpdateAreaStart01" node="0>4|0" />
		<i3dMapping id="tipOcclusionUpdateAreaEnd01" node="0>4|0|0" />
		<i3dMapping id="fillTrigger" node="0>5|0" />
		<i3dMapping id="aiNode" node="0>5|1" />
		<i3dMapping id="loadingMarker" node="0>5|2" />
		<i3dMapping id="waterTankLevel02" node="0>6|0" />
		<i3dMapping id="sellingStation" node="0>9"/>
		<i3dMapping id="exactFillRootNode" node="0>9|0"/>
		<i3dMapping id="aiUnloadingNode" node="0>9|1"/>
	</i3dMappings>
</placeable>
