<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<placeable type="constructible" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../../../../shared/xml/schema/placeable.xsd">
	<storeData>
		<name>Ограждение старой лесопилки</name>
		<functions>
			<function>Для реконструкции ограждения требуются инструменты и доски</function>
		</functions>
		<image>map/placeables/ConstructibleBuildings.dds</image>
		<price>0</price>
		<canBeSold>true</canBeSold>
		<showInStore>false</showInStore>
		<lifetime>100000</lifetime>
		<dailyUpkeep>0</dailyUpkeep>
		<rotation>0</rotation>
		<brand>ConstructibleBuildings</brand>
		<species>placeable</species>
		<category>farmhouses</category>
		<brush>
			<type>placeable</type>
			<category>ConstructibleBuildings</category>
			<tab>constructiblesProductionPoint</tab>
		</brush>
		<vertexBufferMemoryUsage>719616</vertexBufferMemoryUsage>
		<indexBufferMemoryUsage>141312</indexBufferMemoryUsage>
		<textureMemoryUsage>1507328</textureMemoryUsage>
		<instanceVertexBufferMemoryUsage>0</instanceVertexBufferMemoryUsage>
		<instanceIndexBufferMemoryUsage>0</instanceIndexBufferMemoryUsage>

		<storeIconRendering>
			<objectBundle>
				<object filename="map/placeables/CowBarnConstructibles/constructibleFences.i3d">
					<node node="2"/>
				</object>
			</objectBundle>
		</storeIconRendering>
		<audioMemoryUsage>0</audioMemoryUsage>
	</storeData>

	<base>
		<filename>map/placeables/CowBarnConstructibles/constructibleFences.i3d</filename>
		<canBeRenamed>true</canBeRenamed>
		<canBeDeleted>true</canBeDeleted>
		<boughtWithFarmland>true</boughtWithFarmland>
	</base>

	<placement useRandomYRotation="false" useManualYRotation="true">
		<testAreas>
			<testArea startNode="testAreaStart01" endNode="testAreaEnd01" />
		</testAreas>
		<sounds>
			<place template="smallImp" />
		</sounds>
	</placement>

	<clearAreas>
		<clearArea startNode="clearAreaStart01" widthNode="clearAreaWidth01" heightNode="clearAreaHeight01"/>
	</clearAreas>

	<leveling requireLeveling="true" maxSmoothDistance="10" maxSlope="75" maxEdgeAngle="30" >
		<levelAreas>
			<levelArea startNode="levelAreaStart01" widthNode="levelAreaWidth01" heightNode="levelAreaHeight01" />
		</levelAreas>
	</leveling>

	<indoorAreas>
		<indoorArea startNode="indoorAreaStart01" widthNode="indoorAreaWidth01" heightNode="indoorAreaHeight01" />
	</indoorAreas>

	<tipOcclusionUpdateAreas>
		<tipOcclusionUpdateArea startNode="tipOcclusionUpdateAreaStart01" endNode="tipOcclusionUpdateAreaEnd01" />
	</tipOcclusionUpdateAreas>

	<ai>
		<updateAreas>
			<updateArea startNode="tipOcclusionUpdateAreaStart01" endNode="tipOcclusionUpdateAreaEnd01" />
		</updateAreas>
	</ai>

	<infoTrigger triggerNode="infoTrigger"/>

	<hotspots>
		<hotspot type="UNLOADING_PALLET" linkNode="unloadTriggerMarker" teleportNode="unloadTriggerMarker" />
	</hotspots>

	<triggerMarkers>
		<triggerMarker node="unloadTriggerMarker"						adjustToGround="true"	filename="$data/shared/assets/marker/markerIconPallet.i3d"/>
		<triggerMarker node="warningStripes01"/>
		<triggerMarker node="ConstructibleWoodSellActivationTrigger"	adjustToGround="true"	filename="$data/shared/assets/marker/markerIconExclamationMark.i3d" />
	</triggerMarkers>

	<animatedObjects>
		<animatedObject saveId="door05" useAIBlockingRegion="true">
			<animation duration="1.5">
				<part node="gate10mOpenA">
					<keyFrame time="0.1" rotation="0 0 0"/>
					<keyFrame time="1.2" rotation="0 90 0"/>
				</part>
				<part node="gate10mOpenB">
					<keyFrame time="0.1" rotation="0 0 0"/>
					<keyFrame time="1.2" rotation="0 -90 0"/>
				</part>
			</animation>
			<controls triggerNode="gate10mTrigger" posAction="ACTIVATE_HANDTOOL" posText="action_openDoor" negText="action_closeDoor" />
			<sounds>
				<moving linkNode="gate10mSound" template="fenceLoop" />
				<posEnd linkNode="gate10mSound" template="fenceOpen" />
				<negEnd linkNode="gate10mSound" template="fenceClose" />
			</sounds>
		</animatedObject>
	</animatedObjects>

