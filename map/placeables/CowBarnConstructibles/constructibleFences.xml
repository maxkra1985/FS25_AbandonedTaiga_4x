				<state name="FINALIZE" class="ConstructibleStateFinalize" >
					<toggleMesh node="gate10m"			active="true"	updatePhysics="true"/>
					<toggleMesh node="passport"			active="false"	updatePhysics="false"/>
					<toggleMesh node="instrument_10"	active="false"	updatePhysics="false"/>
