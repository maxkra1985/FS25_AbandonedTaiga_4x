<?xml version="1.0" encoding="utf-8" standalone="no"?>
<vehicle type="multipleItemPurchase" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://validation.gdn.giants-software.com/xml/fs25/vehicle.xsd">
	<storeData>
		<name>$l10n_fillType_building_metal</name>
		<specs><weight ignore="true"/></specs>
		<image>map/tools/BuildingMetal/store_BuildingMetal.png</image>
		<price>10000</price>
		<lifetime>600</lifetime>
		<allowLeasing>false</allowLeasing>
		<canBeSold>false</canBeSold>
		<rotation>0</rotation>
		<brand>ConstructibleBuildings</brand>
		<category>pallets</category>
		<financeCategory>OTHER</financeCategory>
		<storeIconRendering>
			<settings centerIcon="true" cameraXRot="-15" cameraYRot="35"/>
		</storeIconRendering>
	</storeData>

	<base>
		<typeDesc>$l10n_typeDesc_building_metal</typeDesc>
		<filename>$data/objects/multiPurchaseItem/multiPurchaseItem.i3d</filename>
		<size width="8.4" length="4" height="3.8"/>
		<components>
			<component centerOfMass="0 0.1 0" solverIterationCount="10" mass="1"/>
		</components>
	</base>

	<fillUnit>
		<fillUnitConfigurations>
			<fillUnitConfiguration>
				<fillUnits>
					<fillUnit fillTypes="BUILDING_METAL" capacity="5000"/>
				</fillUnits>
			</fillUnitConfiguration>
		</fillUnitConfigurations>
	</fillUnit>

	<!-- Создаём самостоятельные длинные поддоны вместо единой покупаемой обёртки. -->
	<multipleItemPurchase filename="map/tools/BuildingMetal/BuildingMetal.xml" isVehicle="true">
		<!-- Центрируем по Z первые один, два или три поддона; по Y не смещаем. -->
		<offsets>
			<offset amount="2" offset="0 0 0.625"/>
			<offset amount="3" offset="0 0 1.25"/>
		</offsets>
		<!-- Три поддона в нижнем ярусе; следующие ставятся над ними. -->
		<!-- Корневой узел I3D развёрнут на 90 градусов: длинная сторона направлена по X. -->
		<!-- Примерные интервалы: 1.25 м между рядами по Z и 0.90 м между ярусами по Y. -->
		<itemPositions>
			<itemPosition position="0 0 0" rotation="0 0 0"/>
			<itemPosition position="0 0 -1.25" rotation="0 0 0"/>
			<itemPosition position="0 0 -2.5" rotation="0 0 0"/>
			<itemPosition position="0 0.9 0" rotation="0 0 0"/>
			<itemPosition position="0 0.9 -1.25" rotation="0 0 0"/>
			<itemPosition position="0 0.9 -2.5" rotation="0 0 0"/>
			<itemPosition position="0 1.8 0" rotation="0 0 0"/>
			<itemPosition position="0 1.8 -1.25" rotation="0 0 0"/>
			<itemPosition position="0 1.8 -2.5" rotation="0 0 0"/>
			<itemPosition position="0 2.7 0" rotation="0 0 0"/>
		</itemPositions>
	</multipleItemPurchase>

	<!-- Доплата за дополнительные поддоны к базовой цене первого. -->
	<multipleItemPurchaseAmountConfigurations>
		<multipleItemPurchaseAmountConfiguration name="1" price="0"/>
		<multipleItemPurchaseAmountConfiguration name="2" price="10000"/>
		<multipleItemPurchaseAmountConfiguration name="3" price="20000"/>
		<multipleItemPurchaseAmountConfiguration name="4" price="30000"/>
		<multipleItemPurchaseAmountConfiguration name="5" price="40000"/>
		<multipleItemPurchaseAmountConfiguration name="6" price="50000"/>
		<multipleItemPurchaseAmountConfiguration name="7" price="60000"/>
		<multipleItemPurchaseAmountConfiguration name="8" price="70000"/>
		<multipleItemPurchaseAmountConfiguration name="9" price="80000"/>
		<multipleItemPurchaseAmountConfiguration name="10" price="90000"/>
	</multipleItemPurchaseAmountConfigurations>
</vehicle>
