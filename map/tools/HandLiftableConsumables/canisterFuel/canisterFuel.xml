		<size width="0.55" length="0.3" height="0.8" />
		<input allowed="false"/>
		<canBeReset>false</canBeReset>
		<supportsPickUp>true</supportsPickUp>
		<components maxMass="50">
			<component centerOfMass="0 0.1 0" solverIterationCount="10" mass="1" />
		</components>
		<showInVehicleMenu>false</showInVehicleMenu>
		<mapHotspot available="false" />
	</base>

	<fillUnit>
		<fillUnitConfigurations>
			<fillUnitConfiguration name="$l10n_configuration_valueDefault">
				<fillUnits removeVehicleIfEmpty="true">
					<fillUnit unitTextOverride="$l10n_unit_literShort" fillTypes="DIESEL DEF" capacity="50" startFillType="DIESEL" startFillLevel="50" ignoreFillLimit="true">
