							<material fillType="DEF" node="canisterFuel_vis_LOD0" refNode="canisterFuelDef_mat"/>
							<material fillType="DEF" node="canisterFuel_vis_LOD1" refNode="canisterFuelDef_mat"/>
						</fillTypeMaterials>
					</fillUnit>
				</fillUnits>
			</fillUnitConfiguration>
		</fillUnitConfigurations>
	</fillUnit>

	<dischargeable requiresTipOcclusionArea="false">
		<dischargeNode node="dischargeNode" emptySpeed="10" fillUnitIndex="1" maxDistance="3" canStartDischargeAutomatically="true">
			<raycast useWorldNegYDirection="true" />
