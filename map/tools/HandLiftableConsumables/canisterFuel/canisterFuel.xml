		<i3dMapping id="canisterFuelDiesel_mat" node="0>0|1" />
		<i3dMapping id="canisterFuelDef_mat" node="0>0|2" />
		<i3dMapping id="tensionBeltShape" node="0>1" />
		<i3dMapping id="dischargeNode" node="0>2" />
		<i3dMapping id="fillTrigger" node="0>3" />
