<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<vehicle type="pallet" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://validation.gdn.giants-software.com/xml/fs25/vehicle.xsd">
	<annotation>Copyright (C) GIANTS Software GmbH, All Rights Reserved.</annotation>

	<storeData>
		<name>$l10n_storeItem_metalPallet</name>
		<image>map/tools/Metal/store_metalPallet.png</image>
		<price>3000</price>
		<category>pallets</category>
		<brand>ConstructibleBuildings</brand>
		<showInStore>false</showInStore>
		<canBeSold>true</canBeSold>
		<financeCategory>OTHER</financeCategory>
		<vertexBufferMemoryUsage>35840</vertexBufferMemoryUsage>
		<indexBufferMemoryUsage>8960</indexBufferMemoryUsage>
		<textureMemoryUsage>1245184</textureMemoryUsage>
		<audioMemoryUsage>0</audioMemoryUsage>
		<instanceVertexBufferMemoryUsage>0</instanceVertexBufferMemoryUsage>
		<instanceIndexBufferMemoryUsage>0</instanceIndexBufferMemoryUsage>
		<storeIconRendering>
			<settings centerIcon="true" cameraXRot="-15" cameraYRot="35"/>
		</storeIconRendering>
		<audioMemoryUsage>0</audioMemoryUsage>
	</storeData>

	<base>
		<typeDesc>$l10n_typeDesc_pallet</typeDesc>
		<filename>map/tools/Metal/metalPallet.i3d</filename>
		<size width="1.3" length="0.9" height="0.9" yRotation="0" />
		<canBeReset>false</canBeReset>
		<components maxMass="1250">
			<component centerOfMass="0 0.2 0" solverIterationCount="10" mass="70"/>
		</components>
		<showInVehicleMenu>false</showInVehicleMenu>
		<mapHotspot available="false" />
		<input allowed="false"/>
	</base>

	<fillUnit>
		<fillUnitConfigurations>
			<fillUnitConfiguration>
				<fillUnits removeVehicleIfEmpty="true">
					<fillUnit unitTextOverride="$l10n_unit_literShort" fillTypes="METAL" startFillType="BUILDING_METAL" startFillLevel="1000" capacity="1000"/>
				</fillUnits>
			</fillUnitConfiguration>
		</fillUnitConfigurations>
	</fillUnit>

	<dischargeable requiresTipOcclusionArea="false">
		<dischargeNode node="dischargeNode" emptySpeed="1000" fillUnitIndex="1" maxDistance="6" canStartDischargeAutomatically="true" playSound="false"/>
	</dischargeable>

	<!--pallet fillUnitIndex="1" linkNode="metalPallet_main_component1">
		<texture diffuse="$data/objects/pallets/shared/euroPallet/euroPalletNew_diffuse.dds"/>
		<texture diffuse="$data/objects/pallets/shared/euroPallet/euroPalletMiddle_diffuse.dds"/>
		<texture diffuse="$data/objects/pallets/shared/euroPallet/euroPalletOld_diffuse.dds"/-->
	<pallet fillUnitIndex="1" node="metalPallet_main_component1">
		<content>
			<object node="metalRoll" tensionBeltNode="metalRollTension"/>
		</content>
		<sounds>
			<unload template="palletsFillWood" pitchScale="0.7" volumeScale="1.5" supportsReverb="false"/>
		</sounds>
	</pallet>

	<dynamicMount triggerNode="dynamicMountTrigger" triggerForceAcceleration="4" additionalMountDistance="0.876" jointTransY="0.106" jointLimitToRotY="true"/>

	<i3dMappings>
		<i3dMapping id="metalPallet_main_component1" node="0>" />
		<i3dMapping id="metalPallet_vis" node="0>0" />
		<i3dMapping id="dischargeNode" node="0>0|0" />
		<i3dMapping id="dynamicMountTrigger" node="0>1" />
		<i3dMapping id="metalRoll" node="0>2|0" />
		<i3dMapping id="metalRollTension" node="0>2|0|0" />
	</i3dMappings>
</vehicle>
