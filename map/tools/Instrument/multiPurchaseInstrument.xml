<?xml version="1.0" encoding="utf-8" standalone="no"?>
<vehicle type="multipleItemPurchase" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://validation.gdn.giants-software.com/xml/fs25/vehicle.xsd">
	<storeData>
		<name>$l10n_fillType_instrument</name>
		<specs>
			<weight ignore="true"/>
		</specs>
		<image>map/tools/Instrument/Instrument.dds</image>
		<price>1500</price>
		<lifetime>600</lifetime>
		<allowLeasing>false</allowLeasing>
		<canBeSold>false</canBeSold>
		<rotation>0</rotation>
		<brand>LIZARD</brand>
		<category>pallets</category>
		<financeCategory>OTHER</financeCategory>
	</storeData>

	<base>
		<typeDesc>$l10n_typeDesc_instrument</typeDesc>
		<filename>$data/objects/multiPurchaseItem/multiPurchaseItem.i3d</filename>
		<size width="3.2" length="6.4" height="1.6"/>
		<components>
			<component centerOfMass="0 0.1 0" solverIterationCount="10" mass="1"/>
		</components>
	</base>

	<fillUnit>
		<fillUnitConfigurations>
			<fillUnitConfiguration>
				<fillUnits>
					<fillUnit fillTypes="INSTRUMENT" capacity="250"/>
				</fillUnits>
			</fillUnitConfiguration>
		</fillUnitConfigurations>
	</fillUnit>

	<!-- Временная обёртка создаёт самостоятельные поддоны и удаляется после покупки. -->
	<multipleItemPurchase filename="map/tools/Instrument/Instrument.xml" isVehicle="true">
		<!-- Приблизительное центрирование сетки в зависимости от количества поддонов. -->
		<offsets>
			<offset amount="2" offset="0.625 0 0"/>
			<offset amount="3" offset="0.625 0 0.525"/>
			<offset amount="5" offset="0.625 0 1.05"/>
			<offset amount="7" offset="0.625 0 1.575"/>
			<offset amount="9" offset="0.625 0 2.1"/>
		</offsets>
		<!-- Сетка 2x5; шаг между поддонами 1.25 м по X и 1.05 м по Z. -->
		<!-- Координаты можно уточнить после проверки на площадке магазина. -->
		<itemPositions>
			<itemPosition position="0 0 0" rotation="0 0 0"/>
			<itemPosition position="-1.25 0 0" rotation="0 0 0"/>
			<itemPosition position="0 0 -1.05" rotation="0 0 0"/>
			<itemPosition position="-1.25 0 -1.05" rotation="0 0 0"/>
			<itemPosition position="0 0 -2.1" rotation="0 0 0"/>
			<itemPosition position="-1.25 0 -2.1" rotation="0 0 0"/>
			<itemPosition position="0 0 -3.15" rotation="0 0 0"/>
			<itemPosition position="-1.25 0 -3.15" rotation="0 0 0"/>
			<itemPosition position="0 0 -4.2" rotation="0 0 0"/>
			<itemPosition position="-1.25 0 -4.2" rotation="0 0 0"/>
		</itemPositions>
	</multipleItemPurchase>

	<!-- Цена конфигурации добавляется к базовой стоимости первого поддона. -->
	<multipleItemPurchaseAmountConfigurations>
		<multipleItemPurchaseAmountConfiguration name="1" price="0"/>
		<multipleItemPurchaseAmountConfiguration name="2" price="1500"/>
		<multipleItemPurchaseAmountConfiguration name="3" price="3000"/>
		<multipleItemPurchaseAmountConfiguration name="4" price="4500"/>
		<multipleItemPurchaseAmountConfiguration name="5" price="6000"/>
		<multipleItemPurchaseAmountConfiguration name="6" price="7500"/>
		<multipleItemPurchaseAmountConfiguration name="7" price="9000"/>
		<multipleItemPurchaseAmountConfiguration name="8" price="10500"/>
		<multipleItemPurchaseAmountConfiguration name="9" price="12000"/>
		<multipleItemPurchaseAmountConfiguration name="10" price="13500"/>
	</multipleItemPurchaseAmountConfigurations>
</vehicle>
