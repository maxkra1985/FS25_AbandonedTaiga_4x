<?xml version="1.0" encoding="iso-8859-1"?>

<i3D name="Wheels.i3d" version="1.6" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://i3d.giants.ch/schema/i3d-1.6.xsd">
  <Asset>
    <Export program="GIANTS Editor 64bit" version="10.0.3"/>
  </Asset>

  <Files>
    <File fileId="4" filename="$data/shaders/vehicleShader.xml"/>
    <File fileId="15" filename="$data/shared/detailLibrary/calibrated/grainClearSmall_specular.png"/>
    <File fileId="17" filename="$data/shared/detailLibrary/calibrated/grainSmall_diffuse.png"/>
    <File fileId="16" filename="$data/shared/detailLibrary/flat_normal.png"/>
    <File fileId="7" filename="$data/shared/detailLibrary/nonMetallic/rubber/rubberBlack_diffuse.dds"/>
    <File fileId="6" filename="$data/shared/detailLibrary/nonMetallic/rubber/rubber_normal.dds"/>
    <File fileId="5" filename="$data/shared/detailLibrary/nonMetallic/rubber/rubber_specular.dds"/>
    <File fileId="13" filename="../Shared/Rim_normal.dds"/>
    <File fileId="14" filename="../Shared/Rim_specular.dds"/>
    <File fileId="2" filename="../Shared/Tire_normal.dds"/>
    <File fileId="3" filename="../Shared/Tire_specular.dds"/>
  </Files>


  <Materials>
    <Material name="rim_mat" materialId="5" diffuseColor="1 1 1 1" customShaderId="4">
      <Normalmap fileId="13"/>
      <Glossmap fileId="14"/>
      <Custommap name="detailSpecular" fileId="15"/>
      <Custommap name="detailNormal" fileId="16"/>
      <Custommap name="detailDiffuse" fileId="17"/>
      <CustomParameter name="colorScale" value="0.09 0.09 0.09"/>
      <CustomParameter name="smoothnessScale" value="0.8"/>
      <CustomParameter name="clearCoatIntensity" value="0.5"/>
      <CustomParameter name="clearCoatSmoothness" value="0.85"/>
    </Material>
    <Material name="Tire_mat" materialId="6" diffuseColor="0.8 0.8 0.8 1" customShaderId="4" customShaderVariation="tirePressureDeformation">
      <Normalmap fileId="2"/>
      <Glossmap fileId="3"/>
      <Custommap name="detailSpecular" fileId="5"/>
      <Custommap name="detailNormal" fileId="6"/>
      <Custommap name="detailDiffuse" fileId="7"/>
    </Material>
  </Materials>


  <Shapes externalShapesFile="Wheels.i3d.shapes">
  </Shapes>

  <Scene>
    <TransformGroup name="Tire" nodeId="12">
      <Shape name="TireLeft" rotation="-6.83019e-06 -0 0" shapeId="1" nodeId="13" castsShadows="true" receiveShadows="true" materialIds="6"/>
      <Shape name="TireRight" shapeId="2" nodeId="14" castsShadows="true" receiveShadows="true" materialIds="6"/>
    </TransformGroup>
    <TransformGroup name="Rim" nodeId="15">
      <Shape name="RimLeft" shapeId="3" nodeId="16" castsShadows="true" receiveShadows="true" materialIds="5"/>
      <Shape name="RimRight" shapeId="4" nodeId="17" castsShadows="true" receiveShadows="true" materialIds="5"/>
    </TransformGroup>
  </Scene>

</i3D>
