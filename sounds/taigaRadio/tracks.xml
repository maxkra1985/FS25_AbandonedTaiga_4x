<?xml version="1.0" encoding="utf-8"?>
<!--
    Радио Заброшенная тайга.
    Композиции подключаются по одной записи track.
    file       — MP3 для транспортного радио (потоковый звук).
    speakerFile — OGG для позиционных радиоприёмников (необязателен).
    title      — надпись в стандартном уведомлении радио.
    durationMs — точная длительность композиции в миллисекундах.
    Без файла или правильной длительности запись пропускается.
    Добавьте сюда собственные композиции после копирования в sounds/taigaRadio/music/.

    Пример (снять комментарий только после добавления файлов):
    <track title="Здесь будет жизнь"
           file="sounds/taigaRadio/music/01_ZdesBudetZhizn.mp3"
           speakerFile="sounds/taigaRadio/music/01_ZdesBudetZhizn.ogg"
           durationMs="238000"/>
-->
<taigaRadio>
	<track title="Заброшенная тайга - Здесь будет жизнь"
		   file="sounds/taigaRadio/01_ZdesBudetZhizn.mp3"
		   durationMs="299000"/>
	<track title="Заброшенная тайга - Таёжная дорога"
		   file="sounds/taigaRadio/02_TayozhnaiaDoroga.mp3"
		   durationMs="316000"/>
	<track title="Заброшенная тайга - Ночная тайга"
		   file="sounds/taigaRadio/03_NochnaiaTaiga.mp3"
		   durationMs="420000"/>
</taigaRadio>
