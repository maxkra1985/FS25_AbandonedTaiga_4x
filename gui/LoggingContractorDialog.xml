<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<GUI onOpen="onOpen" onClose="onClose" onCreate="onCreate">
    <GuiElement profile="newLayer"/>
    <Bitmap profile="dialogFullscreenBg" id="dialogBg"/>

    <GuiElement profile="loggingContractorDialogBg" id="dialogElement">
        <ThreePartBitmap profile="fs25_dialogBgMiddleSmall"/>
        <ThreePartBitmap profile="fs25_dialogBgTopSmall"/>
        <ThreePartBitmap profile="fs25_dialogBgBottom"/>

        <GuiElement profile="loggingContractorContent">
            <Text profile="loggingContractorTitle" text="ПОДРЯДЧИКИ НА ЛЕСОПОВАЛ"/>
            <Text profile="loggingContractorDescription" text="Выберите участок и настройте параметры подрядчика."/>

            <MultiTextOption profile="loggingContractorFarmlandOption"
                             id="farmlandOption"
                             onClick="onClickFarmland"
                             focusInit="onOpen">
                <Text profile="loggingContractorTooltip"
                      name="ignore"
                      text="Показаны только участки, находящиеся во владении вашей фермы."/>
            </MultiTextOption>

            <Text profile="loggingContractorTreeCount" id="treeCountText"/>
            <!-- Девять переключателей пород на странице; остальные доступны
                 через селектор страниц без ограничения количества пород. -->
            <Text profile="loggingContractorSpeciesRow" id="speciesLabel1" position="-65px -195px"/>
            <MultiTextOption profile="loggingContractorSpeciesSwitch" id="speciesOption1" position="245px -195px" onClick="onClickSpecies1"/>
            <Text profile="loggingContractorSpeciesRow" id="speciesLabel2" position="-65px -219px"/>
            <MultiTextOption profile="loggingContractorSpeciesSwitch" id="speciesOption2" position="245px -219px" onClick="onClickSpecies2"/>
            <Text profile="loggingContractorSpeciesRow" id="speciesLabel3" position="-65px -243px"/>
            <MultiTextOption profile="loggingContractorSpeciesSwitch" id="speciesOption3" position="245px -243px" onClick="onClickSpecies3"/>
            <Text profile="loggingContractorSpeciesRow" id="speciesLabel4" position="-65px -267px"/>
            <MultiTextOption profile="loggingContractorSpeciesSwitch" id="speciesOption4" position="245px -267px" onClick="onClickSpecies4"/>
            <Text profile="loggingContractorSpeciesRow" id="speciesLabel5" position="-65px -291px"/>
            <MultiTextOption profile="loggingContractorSpeciesSwitch" id="speciesOption5" position="245px -291px" onClick="onClickSpecies5"/>
            <Text profile="loggingContractorSpeciesRow" id="speciesLabel6" position="-65px -315px"/>
            <MultiTextOption profile="loggingContractorSpeciesSwitch" id="speciesOption6" position="245px -315px" onClick="onClickSpecies6"/>
            <Text profile="loggingContractorSpeciesRow" id="speciesLabel7" position="-65px -339px"/>
            <MultiTextOption profile="loggingContractorSpeciesSwitch" id="speciesOption7" position="245px -339px" onClick="onClickSpecies7"/>
            <Text profile="loggingContractorSpeciesRow" id="speciesLabel8" position="-65px -363px"/>
            <MultiTextOption profile="loggingContractorSpeciesSwitch" id="speciesOption8" position="245px -363px" onClick="onClickSpecies8"/>
            <Text profile="loggingContractorSpeciesRow" id="speciesLabel9" position="-65px -387px"/>
            <MultiTextOption profile="loggingContractorSpeciesSwitch" id="speciesOption9" position="245px -387px" onClick="onClickSpecies9"/>
            <MultiTextOption profile="loggingContractorSpeciesPage" id="speciesPageOption" position="0px -415px" onClick="onClickSpeciesPage"/>

            <!-- Отбор деревьев и обрезка крупных ветвей располагаются в одной строке. -->
            <Text profile="loggingContractorHalfSettingLabel" text="Только помеченные деревья" position="-150px -445px"/>
            <MultiTextOption profile="loggingContractorHalfSettingOption"
                             id="onlyMarkedOption"
                             position="-150px -475px"
                             onClick="onClickOnlyMarkedTrees">
                <Text profile="loggingContractorTooltip"
                      name="ignore"
                      text="При включении подрядчик пересчитает участок и будет работать только с деревьями, отмеченными штатным маркером."/>
            </MultiTextOption>

            <Text profile="loggingContractorHalfSettingLabel" text="Обрезать крупные ветви" position="150px -445px"/>
            <MultiTextOption profile="loggingContractorHalfSettingOption"
                             id="pruneLargeBranchesOption"
                             position="150px -475px"
                             onClick="onClickPruneLargeBranches">
                <Text profile="loggingContractorTooltip"
                      name="ignore"
                      text="Нет: удаление только листвы, без обрезки крупных веток. Да: удаление листвы и обрезка крупных веток."/>
            </MultiTextOption>

            <Text profile="loggingContractorSettingLabel" text="Количество техники" position="0px -535px"/>
            <MultiTextOption profile="loggingContractorSettingOption"
                             id="equipmentOption"
                             position="0px -565px"
                             onClick="onClickEquipment">
                <Text profile="loggingContractorTooltip"
                      name="ignore"
                      text="Количество техники влияет на итоговую сумму договора и скорость выполнения работ."/>
            </MultiTextOption>
            <Text profile="loggingContractorEquipmentHint" id="equipmentHintText"/>

            <Text profile="loggingContractorSettingLabel" text="Длина брёвен" position="0px -645px"/>
            <MultiTextOption profile="loggingContractorSettingOption"
                             id="logLengthOption"
                             position="0px -675px"
                             onClick="onClickLogLength">
                <Text profile="loggingContractorTooltip"
                      name="ignore"
                      text="Подрядчик будет раскряжёвывать стволы на выбранную длину. Короткий остаток сохраняется отдельным бревном."/>
            </MultiTextOption>

            <Text profile="loggingContractorEstimate" id="estimateTimeText" position="0px -740px"/>
            <Text profile="loggingContractorCostLine" id="rentCostText" position="0px -780px"/>
            <Text profile="loggingContractorCostLine" id="equipmentWorkCostText" position="0px -810px"/>
            <Text profile="loggingContractorCostLine" id="workerCostText" position="0px -840px"/>
            <Text profile="loggingContractorTotalCost" id="totalCostText" position="0px -880px"/>
            <Text profile="loggingContractorInfoLine"
                  text="Рабочее время: 08:00–21:00. Игровое ускорение во время работ ограничено x15."
                  position="0px -925px"/>
        </GuiElement>

        <BoxLayout profile="fs25_dialogButtonBox" id="buttonsPC">
            <Button profile="buttonBack" text="$l10n_button_close" onClick="onClickBack"/>
            <Bitmap profile="fs25_dialogButtonBoxSeparator"/>
            <Button profile="buttonActivate"
                    id="startContractButton"
                    text="ЗАКЛЮЧИТЬ ДОГОВОР ПОДРЯДА"
                    onClick="onClickStartContract"/>
        </BoxLayout>
    </GuiElement>

    <GUIProfiles>
        <Profile name="loggingContractorDialogBg" extends="fs25_dialogBg">
            <size value="780px 1080px"/>
        </Profile>

        <Profile name="loggingContractorContent" extends="baseReference" with="anchorTopCenter">
            <size value="720px 1010px"/>
            <position value="0px -15px"/>
        </Profile>

        <Profile name="loggingContractorTitle" extends="fs25_dialogTitle" with="anchorTopCenter">
            <size value="700px 36px"/>
            <position value="0px -20px"/>
        </Profile>

        <Profile name="loggingContractorDescription" extends="fs25_dialogText" with="anchorTopCenter">
            <size value="700px 30px"/>
            <position value="0px -65px"/>
            <textSize value="18px"/>
        </Profile>

        <Profile name="loggingContractorFarmlandOption" extends="fs25_multiTextOption" with="anchorTopCenter">
            <size value="570px 48px"/>
            <position value="0px -105px"/>
        </Profile>

        <Profile name="loggingContractorTreeCount" extends="fs25_textDefault" with="anchorTopCenter">
            <size value="570px 30px"/>
            <position value="0px -165px"/>
            <textSize value="20px"/>
            <textAlignment value="left"/>
            <textVerticalAlignment value="middle"/>
        </Profile>

        <Profile name="loggingContractorSpecies" extends="fs25_dialogText" with="anchorTopCenter">
            <size value="535px 245px"/>
            <position value="18px -195px"/>
            <textSize value="20px"/>
            <textAlignment value="left"/>
            <textVerticalAlignment value="top"/>
            <textMaxNumLines value="12"/>
        </Profile>

        <Profile name="loggingContractorSpeciesRow" extends="fs25_dialogText" with="anchorTopCenter">
            <size value="420px 24px"/>
            <textSize value="18px"/>
            <textAlignment value="left"/>
            <textVerticalAlignment value="middle"/>
        </Profile>

        <Profile name="loggingContractorSpeciesSwitch" extends="fs25_multiTextOption" with="anchorTopCenter">
            <size value="100px 24px"/>
        </Profile>

        <Profile name="loggingContractorSpeciesPage" extends="fs25_multiTextOption" with="anchorTopCenter">
            <size value="165px 26px"/>
        </Profile>

        <Profile name="loggingContractorSettingLabel" extends="fs25_textDefault" with="anchorTopCenter">
            <size value="570px 28px"/>
            <textSize value="20px"/>
            <textAlignment value="left"/>
            <textVerticalAlignment value="middle"/>
        </Profile>

        <Profile name="loggingContractorSettingOption" extends="fs25_multiTextOption" with="anchorTopCenter">
            <size value="570px 48px"/>
        </Profile>

        <Profile name="loggingContractorHalfSettingLabel" extends="loggingContractorSettingLabel">
            <size value="275px 28px"/>
            <textSize value="17px"/>
        </Profile>

        <Profile name="loggingContractorHalfSettingOption" extends="loggingContractorSettingOption">
            <size value="275px 48px"/>
        </Profile>

        <Profile name="loggingContractorEquipmentHint" extends="fs25_dialogText" with="anchorTopCenter">
            <size value="570px 24px"/>
            <position value="0px -617px"/>
            <textSize value="17px"/>
            <textAlignment value="center"/>
        </Profile>

        <Profile name="loggingContractorEstimate" extends="fs25_textDefault" with="anchorTopCenter">
            <size value="570px 30px"/>
            <textSize value="22px"/>
            <textAlignment value="left"/>
            <textVerticalAlignment value="middle"/>
        </Profile>

        <Profile name="loggingContractorCostLine" extends="fs25_textDefault" with="anchorTopCenter">
            <size value="535px 26px"/>
            <textSize value="19px"/>
            <textAlignment value="left"/>
            <textVerticalAlignment value="middle"/>
        </Profile>

        <Profile name="loggingContractorTotalCost" extends="fs25_textDefault" with="anchorTopCenter">
            <size value="570px 30px"/>
            <textSize value="22px"/>
            <textAlignment value="left"/>
            <textVerticalAlignment value="middle"/>
        </Profile>

        <Profile name="loggingContractorTooltip" extends="fs25_multiTextOptionTooltip">
            <size value="520px 72px"/>
            <position value="595px 0px"/>
            <textMaxNumLines value="4"/>
        </Profile>

        <Profile name="loggingContractorInfoLine" extends="fs25_dialogText" with="anchorTopCenter">
            <size value="570px 42px"/>
            <textSize value="17px"/>
            <textAlignment value="center"/>
            <textVerticalAlignment value="middle"/>
            <textMaxNumLines value="2"/>
        </Profile>
    </GUIProfiles>
</GUI>
