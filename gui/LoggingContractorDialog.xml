<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<GUI onOpen="onOpen" onClose="onClose" onCreate="onCreate">
    <GuiElement profile="newLayer"/>
    <Bitmap profile="dialogFullscreenBg" id="dialogBg"/>

    <GuiElement profile="loggingContractorDialogBg" id="dialogElement">
        <ThreePartBitmap profile="fs25_dialogBgMiddleSmall"/>
        <ThreePartBitmap profile="fs25_dialogBgTopSmall"/>
        <ThreePartBitmap profile="fs25_dialogBgBottom"/>

        <GuiElement profile="loggingContractorContent">
            <Text profile="loggingContractorTitle" text="ПОДРЯДЧИКИ НА ЛЕСОПОВАЛ"/>
            <Text profile="loggingContractorDescription" text="Выберите участок и настройте параметры подрядчика."/>

            <MultiTextOption profile="loggingContractorFarmlandOption"
                             id="farmlandOption"
                             onClick="onClickFarmland"
                             focusInit="onOpen"/>

            <Text profile="loggingContractorStatistics" id="statisticsText"/>

            <Text profile="loggingContractorSettingLabel" text="Количество техники" position="0px -390px"/>
            <MultiTextOption profile="loggingContractorSettingOption"
                             id="equipmentOption"
                             position="0px -420px"
                             onClick="onClickEquipment"/>
            <Text profile="loggingContractorEquipmentHint" id="equipmentHintText"/>

            <Text profile="loggingContractorSettingLabel" text="Длина брёвен" position="0px -500px"/>
            <MultiTextOption profile="loggingContractorSettingOption"
                             id="logLengthOption"
                             position="0px -530px"
                             onClick="onClickLogLength"/>

            <Text profile="loggingContractorEstimate" id="estimateTimeText" position="0px -590px"/>
            <Text profile="loggingContractorEstimate" id="estimateCostText" position="0px -625px"/>
        </GuiElement>

        <BoxLayout profile="fs25_dialogButtonBox" id="buttonsPC">
            <Button profile="buttonBack" text="$l10n_button_close" onClick="onClickBack"/>
        </BoxLayout>
    </GuiElement>

    <GUIProfiles>
        <Profile name="loggingContractorDialogBg" extends="fs25_dialogBg">
            <size value="780px 720px"/>
        </Profile>

        <Profile name="loggingContractorContent" extends="baseReference" with="anchorTopCenter">
            <size value="720px 650px"/>
            <position value="0px -15px"/>
        </Profile>

        <Profile name="loggingContractorTitle" extends="fs25_dialogTitle" with="anchorTopCenter">
            <size value="700px 36px"/>
            <position value="0px -20px"/>
        </Profile>

        <Profile name="loggingContractorDescription" extends="fs25_dialogText" with="anchorTopCenter">
            <size value="700px 30px"/>
            <position value="0px -65px"/>
            <textSize value="18px"/>
        </Profile>

        <Profile name="loggingContractorFarmlandOption" extends="fs25_multiTextOption" with="anchorTopCenter">
            <size value="570px 48px"/>
            <position value="0px -105px"/>
        </Profile>

        <Profile name="loggingContractorStatistics" extends="fs25_dialogText" with="anchorTopCenter">
            <size value="570px 220px"/>
            <position value="0px -165px"/>
            <textSize value="20px"/>
            <textAlignment value="left"/>
            <textVerticalAlignment value="top"/>
            <textMaxNumLines value="12"/>
        </Profile>

        <Profile name="loggingContractorSettingLabel" extends="fs25_textDefault" with="anchorTopCenter">
            <size value="570px 28px"/>
            <textSize value="20px"/>
            <textAlignment value="left"/>
            <textVerticalAlignment value="middle"/>
        </Profile>

        <Profile name="loggingContractorSettingOption" extends="fs25_multiTextOption" with="anchorTopCenter">
            <size value="570px 48px"/>
        </Profile>

        <Profile name="loggingContractorEquipmentHint" extends="fs25_dialogText" with="anchorTopCenter">
            <size value="570px 24px"/>
            <position value="0px -472px"/>
            <textSize value="17px"/>
            <textAlignment value="center"/>
        </Profile>

        <Profile name="loggingContractorEstimate" extends="fs25_textDefault" with="anchorTopCenter">
            <size value="570px 30px"/>
            <textSize value="22px"/>
            <textAlignment value="left"/>
            <textVerticalAlignment value="middle"/>
        </Profile>
    </GUIProfiles>
</GUI>
